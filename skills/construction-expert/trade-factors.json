  "plumbing": {
    "fittings": {
      "coupling": {
        "factor": 0.10,
        "unit": "EA per LF",
        "rationale": "10-foot pipe sticks = 1 coupling per 10 LF"
      },
      "elbow_90": {
        "factor": 0.05,
        "unit": "EA per LF", 
        "rationale": "Direction change every ~20 LF average"
      },
      "elbow_45": {
        "factor": 0.025,
        "unit": "EA per LF",
        "rationale": "Half as common as 90° elbows"
      },
      "tee": {
        "factor": 0.02,
        "unit": "EA per LF",
        "rationale": "Branch connection every ~50 LF"
      },
      "cap": {
        "factor": 0.005,
        "unit": "EA per LF",
        "rationale": "End terminations relatively rare"
      },
      "cleanout": {
        "factor": 0.01,
        "unit": "EA per LF",
        "rationale": "Code requires ~every 100 LF"
      },
      "valve_gate": {
        "factor": 0.02,
        "unit": "EA per LF",
        "rationale": "Isolation valve every ~50 LF"
      },
      "valve_ball": {
        "factor": 0.02,
        "unit": "EA per LF",
        "rationale": "Equipment/fixture isolation"
      },
      "union": {
        "factor": 0.02,
        "unit": "EA per LF",
        "rationale": "Equipment connections for serviceability"
      },
      "reducer": {
        "factor": 0.015,
        "unit": "EA per LF",
        "rationale": "Size transitions ~every 65 LF"
      },
      "flange": {
        "factor": 0.01,
        "unit": "EA per LF",
        "rationale": "Equipment and valve connections"
      }
    },
    "supports": {
      "pipe_hanger": {
        "factor": 0.125,
        "unit": "EA per LF",
        "rationale": "Code minimum every 8 LF horizontal"
      },
      "riser_clamp": {
        "factor": 0.05,
        "unit": "EA per LF",
        "rationale": "Every 20 LF on vertical runs"
      },
      "clevis_hanger": {
        "factor": 0.10,
        "unit": "EA per LF",
        "rationale": "Every 10 LF typical commercial"
      },
      "strut_channel": {
        "factor": 0.20,
        "unit": "LF per LF of pipe",
        "rationale": "Trapeze supports every 5 LF"
      }
