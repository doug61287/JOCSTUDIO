r/clawd/projects/medtech-bot/data/manuals/devilbiss/DeVilbiss_525D_User_Guide.pdf\n/home/ec2-user/clawd/projects/medtech-bot/data/manuals/devilbiss/DeVilbiss_515_Service_Manual.pdf\n/home/ec2-user/clawd/projects/medtech-bot/data/manuals/devilbiss/DeVilbiss_515A_Service_Manual.pdf\n/home/ec2-user/clawd/projects/medtech-bot/data/manuals/devilbiss/DeVilbiss_525_Service_Manual.pdf\n/home/ec2-user/clawd/projects/medtech-bot/data/manuals/devilbiss/DeVilbiss_535D_Service_Manual.pdf\n/home/ec2-user/clawd/projects/medtech-bot/data/manuals/devilbiss/DeVilbiss_303_501_505_Service_Manual.pdf\n/home/ec2-user/clawd/projects/medtech-bot/data/manuals/devilbiss/DeVilbiss_Maintenance_Log.pdf\n/home/ec2-user/clawd/projects/medtech-bot/data/manuals/devilbiss/DeVilbiss_515_User_Guide.pdf"}],"details":{"status":"completed","exitCode":0,"durationMs":22,"aggregated":"/home/ec2-user/clawd/projects/medtech-bot/src/routes/health.js\n/home/ec2-user/clawd/projects/medtech-bot/src/routes/webhook.js\n/home/ec2-user/clawd/projects/medtech-bot/src/routes/admin.js\n/home/ec2-user/clawd/projects/medtech-bot/src/services/whatsapp.js\n/home/ec2-user/clawd/projects/medtech-bot/src/services/troubleshootingTrees.js\n/home/ec2-user/clawd/projects/medtech-bot/src/services/crossFacilityLearning.js\n/home/ec2-user/clawd/projects/medtech-bot/src/services/conversationEngine.js\n/home/ec2-user/clawd/projects/medtech-bot/src/models/db.js\n/home/ec2-user/clawd/projects/medtech-bot/src/index.js\n/home/ec2-user/clawd/projects/medtech-bot/src/i18n/strings.js\n/home/ec2-user/clawd/projects/medtech-bot/src/server.js\n/home/ec2-user/clawd/projects/medtech-bot/data/troubleshooting-trees/oxygen_concentrator.json\n/home/ec2-user/clawd/projects/medtech-bot/data/troubleshooting-trees/patient_monitor.json\n/home/ec2-user/clawd/projects/medtech-bot/data/troubleshooting-trees/infant_incubator.json\n/home/ec2-user/clawd/projects/medtech-bot/data/troubleshooting-trees/oxygen_concentrator.json.bak\n/home/ec2-user/clawd/projects/me