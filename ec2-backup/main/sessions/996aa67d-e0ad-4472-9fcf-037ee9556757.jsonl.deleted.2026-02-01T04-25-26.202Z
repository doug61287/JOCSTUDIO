{"type":"message","id":"d0e29525","parentId":"bf5b2ad1","timestamp":"2026-02-01T03:27:30.083Z","message":{"role":"assistant","content":[{"type":"text","text":"Now let me build the multi-strategy paper trader:"},{"type":"toolCall","id":"toolu_01CHe7GCZXoDHjMX2jZrrPKm","name":"write","arguments":{"path":"/home/ec2-user/clawd/projects/polymarket-copytrade/src/multi-strategy-paper.js","content":"const fetch = require('node-fetch');\nconst fs = require('fs');\nconst path = require('path');\n\n// ─── Config ───────────────────────────────────────────────────────────────────\nconst GAMMA_API = 'https://gamma-api.polymarket.com';\nconst CLOB_API = 'https://clob.polymarket.com';\nconst DATA_DIR = path.join(__dirname, '..', 'data');\nconst STATE_FILE = path.join(DATA_DIR, 'strategy-state.json');\nconst TRADES_FILE = path.join(DATA_DIR, 'strategy-trades.jsonl');\nconst PRICE_HISTORY_FILE = path.join(DATA_DIR, 'price-history.json');\nconst WHALE_FILE = path.join(DATA_DIR, 'whale-activity.jsonl');\nconst DAILY_REPORT_JSON = path.join(DATA_DIR, 'daily-report.json');\nconst DAILY_REPORT_TXT = path.join(DATA_DIR, 'daily-report-latest.txt');\n\nconst SCAN_INTERVAL = 10_000;       // 10s for arb strategies\nconst PRICE_INTERVAL = 5 * 60_000;  // 5min for price history\nconst RESOLUTION_INTERVAL = 60 * 60_000; // 1h for resolution check\nconst REPORT_INTERVAL = 24 * 60 * 60_000; // 24h\nconst WHALE_CHECK_INTERVAL = 30_000; // 30s\n\nif (!fs.existsSync(DATA_DIR)) fs.mkdirSync(DATA_DIR, { recursive: true });\n\n// ─── Logging ──────────────────────────────────────────────────────────────────\nfunction log(strategy, ...args) {\n  console.log(`[${new Date().toISOString()}] [${strategy}]`, ...args);\n}\n\n// ─── Retry fetch ──────────────────────────────────────────────────────────────\nasync function retryFetch(url, opts = {}, retries = 3) {\n  for (let i = 0; i < retries; i++) {\n    try {\n      const r = await fetch(url, { timeout: 15000, ...opts });\n      if (r.ok) return r;\n      if (r.status === 429 || r.status >= 500) {\n        await sleep(2000 * (i + 1));\n        continue;\n      }\n      return r;\n    } catch (e) {\n      if (i === retries - 1) throw e;\n      await sleep(2000 * (i + 1));\n    }\n  }\n  return null;\n}\n\nfunction sleep(ms) { return new Promise(r => setTimeout(r, ms)); }\n\n// ─── State Management ─────────────────────────────────────────────────────────\nconst STRATEGY_NAMES = ['simple-arb', 'spread-tightening', 'whale-signal', 'mean-reversion', 'multi-outcome', 'momentum'];\n\nfunction initState() {\n  if (fs.existsSync(STATE_FILE)) {\n    try {\n      const s = JSON.parse(fs.readFileSync(STATE_FILE, 'utf8'));\n      // Ensure all strategies exist\n      for (const name of STRATEGY_NAMES) {\n        if (!s.strategies[name]) {\n          s.strategies[name] = { capital: 1000, positions: [], trades: [], pnl: 0 };\n        }\n      }\n      return s;\n    } catch (e) {\n      log('SYSTEM', 'Corrupt state file, reinitializing');\n    }\n  }\n  const strategies = {};\n  for (const name of STRATEGY_NAMES) {\n    strategies[name] = { capital: 1000, positions: [], trades: [], pnl: 0 };\n  }\n  return { strategies, startedAt: new Date().toISOString() };\n}\n\nlet state = initState();\n\nfunction saveState() {\n  fs.writeFileSync(STATE_FILE, JSON.stringify(state, null, 2));\n}\n\nfunction logTrade(trade) {\n  fs.appendFileSync(TRADES_FILE, JSON.stringify(trade) + '\\n');\n}\n\n// ─── Price History ────────────────────────────────────────────────────────────\nlet priceHistory = {};\n\nfunction loadPriceHistory() {\n  if (fs.existsSync(PRICE_HISTORY_FILE)) {\n    try {\n      priceHistory = JSON.parse(fs.readFileSync(PRICE_HISTORY_FILE, 'utf8'));\n    } catch { priceHistory = {}; }\n  }\n}\n\nfunction savePriceHistory() {\n  fs.writeFileSync(PRICE_HISTORY_FILE, JSON.stringify(priceHistory));\n}\n\nfunction pruneHistory() {\n  const cutoff = Date.now() / 1000 - 86400;\n  for (const tok of Object.keys(priceHistory)) {\n    priceHistory[tok] = priceHistory[tok].filter(p => p.t > cutoff);\n    if (priceHistory[tok].length === 0) delete priceHistory[tok];\n  }\n}\n\n// ─── Market Fetching ──────────────────────────────────────────────────────────\nlet cachedMarkets = [];\nlet lastMarketFetch = 0;\n\nasync function fetchActiveMarkets(force = false) {\n  if (!force && Date.now() - lastMarketFetch < 60000 && cachedMarkets.length > 0) {\n    return cachedMarkets;\n  }\n  const markets = [];\n  let offset = 0;\n  const limit = 100;\n  while (offset < 2000) {\n    try {\n      const r = await retryFetch(`${GAMMA_API}/markets?limit=${limit}&offset=${offset}&active=true&closed=false`);\n      if (!r || !r.ok) break;\n      const data = await r.json();\n      if (!data.length) break;\n      for (const m of data) {\n        if (m.clobTokenIds && m.active && !m.closed) markets.push(m);\n      }\n      if (data.length < limit) break;\n      offset += limit;\n    } catch (e) {\n      log('SYSTEM', 'Market fetch error:', e.message);\n      break;\n    }\n  }\n  cachedMarkets = markets;\n  lastMarketFetch = Date.now();\n  log('SYSTEM', `Fetched ${markets.length} active markets`);\n  return markets;\n}\n\nasync function fetchOrderBook(tokenId) {\n  try {\n    const r = await retryFetch(`${CLOB_API}/book?token_id=${tokenId}`);\n    if (!r || !r.ok) return null;\n    return await r.json();\n  } catch { return null; }\n}\n\nfunction getBestAsk(book) {\n  if (!book?.asks?.length) return null;\n  let best = null;\n  for (const a of book.asks) {\n    const price = parseFloat(a.price), size = parseFloat(a.size);\n    if (!best || price < best.price) best = { price, size };\n  }\n  return best;\n}\n\nfunction getBestBid(book) {\n  if (!book?.bids?.length) return null;\n  let best = null;\n  for (const b of book.bids) {\n    const price = parseFloat(b.price), size = parseFloat(b.size);\n    if (!best || price > best.price) best = { price, size };\n  }\n  return best;\n}\n\nfunction getMidPrice(book) {\n  const ask = getBestAsk(book);\n  const bid = getBestBid(book);\n  if (ask && bid) return (ask.price + bid.price) / 2;\n  if (ask) return ask.price;\n  if (bid) return bid.price;\n  return null;\n}\n\n// ─── Strategy helpers ─────────────────────────────────────────────────────────\nfunction hasPosition(strategyName, conditionId) {\n  return state.strategies[strategyName].positions.some(p => p.conditionId === conditionId);\n}\n\nfunction addPosition(strategyName, pos) {\n  state.strategies[strategyName].positions.push(pos);\n  state.strategies[strategyName].capital -= pos.cost;\n}\n\nfunction closePosition(strategyName, idx, sellPrice, reason) {\n  const s = state.strategies[strategyName];\n  const pos = s.positions[idx];\n  const proceeds = pos.size * sellPrice;\n  const profit = proceeds - pos.cost;\n  s.capital += proceeds;\n  s.pnl += profit;\n  s.trades.push({\n    ...pos, closedAt: new Date().toISOString(), sellPrice, profit, reason\n  });\n  logTrade({\n    ts: new Date().toISOString(), strategy: strategyName, action: 'sell',\n    market: pos.market, side: pos.side, price: sellPrice,\n    size: pos.size, reason, profit: profit.toFixed(4)\n  });\n  s.positions.splice(idx, 1);\n}\n\n// ─── Strategy 1: Simple Arb ──────────────────────────────────────────────────\nasync function runSimpleArb(markets) {\n  const s = state.strategies['simple-arb'];\n  \n  // Check exits first\n  for (let i = s.positions.length - 1; i >= 0; i--) {\n    const pos = s.positions[i];\n    try {\n      const tokenIds = JSON.parse(pos.tokenIds);\n      const [b1, b2] = await Promise.all([fetchOrderBook(tokenIds[0]), fetchOrderBook(tokenIds[1])]);\n      const bid1 = getBestBid(b1), bid2 = getBestBid(b2);\n      if (bid1 && bid2 && bid1.price + bid2.price > 0.99) {\n        const sellPrice = (bid1.price + bid2.price) / 2;\n        closePosition('simple-arb', i, sellPrice, 'spread narrowed >0.99');\n        log('simple-arb', `Early exit: ${pos.market} at ${(bid1.price + bid2.price).toFixed(4)}`);\n      }\n    } catch {}\n  }\n\n  // Scan for new opportunities\n  const binaryMarkets = markets.filter(m => {\n    try { return JSON.parse(m.clobTokenIds).length === 2; } catch { return false; }\n  });\n\n  // Sample up to 50 markets per scan to avoid rate limits\n  const sample = binaryMarkets.sort(() => Math.random() - 0.5).slice(0, 50);\n\n  for (const m of sample) {\n    if (s.capital < 10) break;\n    if (hasPosition('simple-arb', m.conditionId)) continue;\n    \n    try {\n      const tokenIds = JSON.parse(m.clobTokenIds);\n      const [b1, b2] = await Promise.all([fetchOrderBook(tokenIds[0]), fetchOrderBook(tokenIds[1])]);\n      const ask1 = getBestAsk(b1), ask2 = getBestAsk(b2);\n      if (!ask1 || !ask2) continue;\n      \n      const totalCost = ask1.price + ask2.price;\n      if (totalCost < 0.95) {\n        const maxSize = Math.min(50, s.capital, ask1.size * ask1.price, ask2.size * ask2.price);\n        if (maxSize < 5) continue;\n        \n        const cost = maxSize * totalCost;\n        const pos = {\n          conditionId: m.conditionId, market: m.question || m.slug,\n          tokenIds: m.clobTokenIds, side: 'BOTH', entryPrice: totalCost,\n          size: maxSize, cost, openedAt: new Date().toISOString()\n        };\n        addPosition('simple-arb', pos);\n        logTrade({\n          ts: new Date().toISOString(), strategy: 'simple-arb', action: 'buy',\n          market: m.slug, side: 'BOTH', price: totalCost, size: maxSize,\n          reason: `spread=${totalCost.toFixed(4)}`\n        });\n        log('simple-arb', `BUY BOTH ${m.slug} spread=${totalCost.toFixed(4)} size=$${maxSize.toFixed(2)}`);\n      }\n    } catch {}\n  }\n}\n\n// ─── Strategy 2: Spread Tightening ───────────────────────────────────────────\nasync function runSpreadTightening(markets) {\n  const s = state.strategies['spread-tightening'];\n  const FEE_RATE = 0.02; // 2% round-trip\n\n  // Check exits\n  for (let i = s.positions.length - 1; i >= 0; i--) {\n    const pos = s.positions[i];\n    try {\n      const tokenIds = JSON.parse(pos.tokenIds);\n      const [b1, b2] = await Promise.all([fetchOrderBook(tokenIds[0]), fetchOrderBook(tokenIds[1])]);\n      const bid1 = getBestBid(b1), bid2 = getBestBid(b2);\n      if (bid1 && bid2 && bid1.price + bid2.price > 0.99) {\n        const gross = (bid1.price + bid2.price);\n        const net = gross - (gross * FEE_RATE);\n        closePosition('spread-tightening', i, net / 2, 'spread narrowed >0.99 (after fees)');\n        log('spread-tightening', `Early exit: ${pos.market}`);\n      }\n    } catch {}\n  }\n\n  const binaryMarkets = markets.filter(m => {\n    try { return JSON.parse(m.clobTokenIds).length === 2; } catch { return false; }\n  });\n  const sample = binaryMarkets.sort(() => Math.random() - 0.5).slice(0, 50);\n\n  for (const m of sample) {\n    if (s.capital < 10) break;\n    if (hasPosition('spread-tightening', m.conditionId)) continue;\n    \n    try {\n      const tokenIds = JSON.parse(m.clobTokenIds);\n      const [b1, b2] = await Promise.all([fetchOrderBook(tokenIds[0]), fetchOrderBook(tokenIds[1])]);\n      const ask1 = getBestAsk(b1), ask2 = getBestAsk(b2);\n      if (!ask1 || !ask2) continue;\n      \n      const totalCost = ask1.price + ask2.price;\n      const totalWithFees = totalCost * (1 + FEE_RATE);\n      \n      if (totalCost < 0.98 && totalWithFees < 0.96) {\n        const maxSize = Math.min(50, s.capital, ask1.size * ask1.price, ask2.size * ask2.price);\n        if (maxSize < 5) continue;\n        \n        const cost = maxSize * totalWithFees;\n        const pos = {\n          conditionId: m.conditionId, market: m.question || m.slug,\n          tokenIds: m.clobTokenIds, side: 'BOTH', entryPrice: totalWithFees,\n          size: maxSize, cost, openedAt: new Date().toISOString()\n        };\n        addPosition('spread-tightening', pos);\n        logTrade({\n          ts: new Date().toISOString(), strategy: 'spread-tightening', action: 'buy',\n          market: m.slug, side: 'BOTH', price: totalWithFees, size: maxSize,\n          reason: `spread=${totalCost.toFixed(4)} after_fees=${totalWithFees.toFixed(4)}`\n        });\n        log('spread-tightening', `BUY ${m.slug} spread=${totalCost.toFixed(4)} w/fees=${totalWithFees.toFixed(4)}`);\n      }\n    } catch {}\n  }\n}\n\n// ─── Strategy 3: Whale Signal ────────────────────────────────────────────────\nlet lastWhaleOffset = 0;\n\nfunction readNewWhaleActivity() {\n  if (!fs.existsSync(WHALE_FILE)) return [];\n  try {\n    const content = fs.readFileSync(WHALE_FILE, 'utf8').trim();\n    if (!content) return [];\n    const lines = content.split('\\n');\n    const newLines = lines.slice(lastWhaleOffset);\n    lastWhaleOffset = lines.length;\n    return newLines.map(l => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean);\n  } catch { return []; }\n}\n\nasync function runWhaleSignal(markets) {\n  const s = state.strategies['whale-signal'];\n  const now = Date.now();\n  const DAY_MS = 24 * 60 * 60 * 1000;\n\n  // Check exits: 24h timeout, 15% profit, 10% stop-loss\n  for (let i = s.positions.length - 1; i >= 0; i--) {\n    const pos = s.positions[i];\n    try {\n      const tokenIds = JSON.parse(pos.tokenIds);\n      const tokenIdx = pos.side === 'YES' ? 0 : 1;\n      const book = await fetchOrderBook(tokenIds[tokenIdx]);\n      const bid = getBestBid(book);\n      if (!bid) continue;\n\n      const pnlPct = (bid.price - pos.entryPrice) / pos.entryPrice;\n      const age = now - new Date(pos.openedAt).getTime();\n\n      if (pnlPct >= 0.15) {\n        closePosition('whale-signal', i, bid.price, '15% profit target');\n        log('whale-signal', `PROFIT EXIT ${pos.market} +${(pnlPct*100).toFixed(1)}%`);\n      } else if (pnlPct <= -0.10) {\n        closePosition('whale-signal', i, bid.price, '10% stop-loss');\n        log('whale-signal', `STOP LOSS ${pos.market} ${(pnlPct*100).toFixed(1)}%`);\n      } else if (age > DAY_MS) {\n        closePosition('whale-signal', i, bid.price, '24h timeout');\n        log('whale-signal', `TIMEOUT ${pos.market} ${(pnlPct*100).toFixed(1)}%`);\n      }\n    } catch {}\n  }\n\n  // Read new whale trades\n  const whaleActions = readNewWhaleActivity();\n  const buySignals = whaleActions.filter(a => \n    a.side === 'YES' || a.type === 'buy' || (a.action === 'buy' && (!a.side || a.side === 'YES'))\n  );\n\n  for (const signal of buySignals) {\n    if (s.capital < 25) break;\n    const slug = signal.market || signal.slug || signal.conditionId;\n    if (!slug) continue;\n\n    // Find matching market\n    const market = markets.find(m => \n      m.slug === slug || m.conditionId === slug || m.question === slug\n    );\n    if (!market) continue;\n    if (hasPosition('whale-signal', market.conditionId)) continue;\n\n    try {\n      const tokenIds = JSON.parse(market.clobTokenIds);\n      if (tokenIds.length < 1) continue;\n      const book = await fetchOrderBook(tokenIds[0]); // YES token\n      const ask = getBestAsk(book);\n      if (!ask) continue;\n\n      const size = Math.min(25, s.capital);\n      const shares = size / ask.price;\n      const pos = {\n        conditionId: market.conditionId, market: market.question || market.slug,\n        tokenIds: market.clobTokenIds, side: 'YES', entryPrice: ask.price,\n        size: shares, cost: size, openedAt: new Date().toISOString(),\n        whaleInfo: signal\n      };\n      addPosition('whale-signal', pos);\n      logTrade({\n        ts: new Date().toISOString(), strategy: 'whale-signal', action: 'buy',\n        market: market.slug, side: 'YES', price: ask.price, size,\n        reason: `whale buy signal from ${signal.wallet || 'unknown'}`\n      });\n      log('whale-signal', `BUY YES ${market.slug} @ ${ask.price.toFixed(4)} following whale`);\n    } catch {}\n  }\n}\n\n// ─── Strategy 4: Mean Reversion ──────────────────────────────────────────────\nasync function runMeanReversion(markets) {\n  const s = state.strategies['mean-reversion'];\n  const now = Date.now() / 1000;\n  const DAY_MS = 24 * 60 * 60 * 1000;\n\n  // Check exits\n  for (let i = s.positions.length - 1; i >= 0; i--) {\n    const pos = s.positions[i];\n    try {\n      const tokenIds = JSON.parse(pos.tokenIds);\n      const tokenIdx = pos.side === 'YES' ? 0 : 1;\n      const book = await fetchOrderBook(tokenIds[tokenIdx]);\n      const bid = getBestBid(book);\n      if (!bid) continue;\n\n      const pnlPct = (bid.price - pos.entryPrice) / pos.entryPrice;\n      const age = Date.now() - new Date(pos.openedAt).getTime();\n\n      // Check 50% reversion\n      if (pos.moveAmount) {\n        const targetReversion = pos.moveAmount * 0.5;\n        const currentReversion = pos.side === 'YES' ? \n          (bid.price - pos.entryPrice) : (pos.entryPrice - bid.price);\n        if (currentReversion >= targetReversion * pos.entryPrice) {\n          closePosition('mean-reversion', i, bid.price, '50% reversion');\n          log('mean-reversion', `REVERSION EXIT ${pos.market}`);\n          continue;\n        }\n      }\n\n      if (pnlPct <= -0.15) {\n        closePosition('mean-reversion', i, bid.price, '15% stop-loss');\n        log('mean-reversion', `STOP LOSS ${pos.market}`);\n      } else if (age > DAY_MS) {\n        closePosition('mean-reversion', i, bid.price, '24h timeout');\n        log('mean-reversion', `TIMEOUT ${pos.market}`);\n      }\n    } catch {}\n  }\n\n  // Look for >10% moves in 1 hour\n  const oneHourAgo = now - 3600;\n  for (const [tokenId, history] of Object.entries(priceHistory)) {\n    if (s.capital < 25) break;\n    const hourAgoPoints = history.filter(p => p.t >= oneHourAgo - 300 && p.t <= oneHourAgo + 300);\n    if (hourAgoPoints.length === 0) continue;\n    const latest = history[history.length - 1];\n    if (!latest || now - latest.t > 600) continue;\n\n    const oldPrice = hourAgoPoints[0].p;\n    const newPrice = latest.p;\n    const change = (newPrice - oldPrice) / oldPrice;\n\n    if (Math.abs(change) > 0.10) {\n      // Find market for this token\n      const market = markets.find(m => {\n        try {\n          const ids = JSON.parse(m.clobTokenIds);\n          return ids.includes(tokenId);\n        } catch { return false; }\n      });\n      if (!market) continue;\n      if (hasPosition('mean-reversion', market.conditionId)) continue;\n\n      // Bet against the move\n      const side = change > 0 ? 'NO' : 'YES';\n      try {\n        const tokenIds = JSON.parse(market.clobTokenIds);\n        const tokenIdx = side === 'YES' ? 0 : 1;\n        const book = await fetchOrderBook(tokenIds[tokenIdx]);\n        const ask = getBestAsk(book);\n        if (!ask) continue;\n\n        const size = Math.min(25, s.capital);\n        const shares = size / ask.price;\n        const pos = {\n          conditionId: market.conditionId, market: market.question || market.slug,\n          tokenIds: market.clobTokenIds, side, entryPrice: ask.price,\n          size: shares, cost: size, openedAt: new Date().toISOString(),\n          moveAmount: Math.abs(change)\n        };\n        addPosition('mean-reversion', pos);\n        logTrade({\n          ts: new Date().toISOString(), strategy: 'mean-reversion', action: 'buy',\n          market: market.slug, side, price: ask.price, size,\n          reason: `${(change*100).toFixed(1)}% move in 1h`\n        });\n        log('mean-reversion', `BUY ${side} ${market.slug} after ${(change*100).toFixed(1)}% move`);\n      } catch {}\n    }\n  }\n}\n\n// ─── Strategy 5: Multi-Outcome ───────────────────────────────────────────────\nasync function runMultiOutcome(markets) {\n  const s = state.strategies['multi-outcome'];\n\n  // Group markets by group_slug\n  const groups = {};\n  for (const m of markets) {\n    if (m.groupSlug || m.group_slug) {\n      const slug = m.groupSlug || m.group_slug;\n      if (!groups[slug]) groups[slug] = [];\n      groups[slug].push(m);\n    }\n  }\n\n  for (const [slug, group] of Object.entries(groups)) {\n    if (group.length < 3) continue;\n    if (s.capital < 10) break;\n    if (s.positions.some(p => p.groupSlug === slug)) continue;\n\n    try {\n      let totalAskSum = 0;\n      const outcomes = [];\n      \n      for (const m of group) {\n        const tokenIds = JSON.parse(m.clobTokenIds);\n        if (tokenIds.length < 1) continue;\n        const book = await fetchOrderBook(tokenIds[0]); // YES token\n        const ask = getBestAsk(book);\n        if (!ask) { totalAskSum = 999; break; }\n        totalAskSum += ask.price;\n        outcomes.push({ market: m, tokenId: tokenIds[0], price: ask.price });\n      }\n\n      if (totalAskSum < 0.90 && outcomes.length >= 3) {\n        const totalSize = Math.min(50, s.capital);\n        const perOutcome = totalSize / outcomes.length;\n        \n        const pos = {\n          groupSlug: slug, conditionId: slug,\n          market: `Multi: ${slug} (${outcomes.length} outcomes)`,\n          outcomes: outcomes.map(o => ({\n            conditionId: o.market.conditionId,\n            tokenId: o.tokenId,\n            price: o.price,\n            shares: perOutcome / o.price\n          })),\n          side: 'ALL_YES', entryPrice: totalAskSum,\n          size: totalSize / totalAskSum, cost: totalSize,\n          openedAt: new Date().toISOString()\n        };\n        addPosition('multi-outcome', pos);\n        logTrade({\n          ts: new Date().toISOString(), strategy: 'multi-outcome', action: 'buy',\n          market: slug, side: 'ALL_YES', price: totalAskSum, size: totalSize,\n          reason: `${outcomes.length} outcomes, sum=${totalAskSum.toFixed(4)}`\n        });\n        log('multi-outcome', `BUY ALL ${slug} (${outcomes.length} outcomes) sum=${totalAskSum.toFixed(4)} $${totalSize.toFixed(2)}`);\n      }\n    } catch {}\n  }\n}\n\n// ─── Strategy 6: Momentum ────────────────────────────────────────────────────\nasync function runMomentum(markets) {\n  const s = state.strategies['momentum'];\n  const now = Date.now() / 1000;\n  const DAY_MS = 48 * 60 * 60 * 1000;\n\n  // Check exits\n  for (let i = s.positions.length - 1; i >= 0; i--) {\n    const pos = s.positions[i];\n    try {\n      const tokenIds = JSON.parse(pos.tokenIds);\n      const tokenIdx = pos.side === 'YES' ? 0 : 1;\n      const book = await fetchOrderBook(tokenIds[tokenIdx]);\n      const bid = getBestBid(book);\n      if (!bid) continue;\n\n      const pnlPct = (bid.price - pos.entryPrice) / pos.entryPrice;\n      const age = Date.now() - new Date(pos.openedAt).getTime();\n\n      // 3% reversal exit\n      if (pnlPct <= -0.03) {\n        closePosition('momentum', i, bid.price, 'trend reversal (3% against)');\n        log('momentum', `REVERSAL EXIT ${pos.market}`);\n      } else if (pnlPct <= -0.10) {\n        closePosition('momentum', i, bid.price, '10% stop-loss');\n        log('momentum', `STOP LOSS ${pos.market}`);\n      } else if (age > DAY_MS) {\n        closePosition('momentum', i, bid.price, '48h timeout');\n        log('momentum', `TIMEOUT ${pos.market}`);\n      }\n    } catch {}\n  }\n\n  // Look for >5% moves in same direction over 3+ hours\n  const threeHoursAgo = now - 10800;\n  for (const [tokenId, history] of Object.entries(priceHistory)) {\n    if (s.capital < 25) break;\n    const recent = history.filter(p => p.t >= threeHoursAgo);\n    if (recent.length < 3) continue; // need at least 3 data points\n\n    const first = recent[0];\n    const last = recent[recent.length - 1];\n    const change = (last.p - first.p) / first.p;\n\n    if (Math.abs(change) < 0.05) continue;\n\n    // Check if movement is consistent (all intermediate points trend same direction)\n    let consistent = true;\n    const direction = change > 0 ? 1 : -1;\n    for (let j = 1; j < recent.length; j++) {\n      const midChange = (recent[j].p - first.p) / first.p;\n      // Allow some noise but overall direction should hold\n      if (direction > 0 && midChange < -0.02) { consistent = false; break; }\n      if (direction < 0 && midChange > 0.02) { consistent = false; break; }\n    }\n    if (!consistent) continue;\n\n    const market = markets.find(m => {\n      try {\n        const ids = JSON.parse(m.clobTokenIds);\n        return ids.includes(tokenId);\n      } catch { return false; }\n    });\n    if (!market) continue;\n    if (hasPosition('momentum', market.conditionId)) continue;\n\n    // Follow the trend\n    const side = change > 0 ? 'YES' : 'NO';\n    try {\n      const tokenIds = JSON.parse(market.clobTokenIds);\n      const tokenIdx = side === 'YES' ? 0 : 1;\n      const book = await fetchOrderBook(tokenIds[tokenIdx]);\n      const ask = getBestAsk(book);\n      if (!ask) continue;\n\n      const size = Math.min(25, s.capital);\n      const shares = size / ask.price;\n      const pos = {\n        conditionId: market.conditionId, market: market.question || market.slug,\n        tokenIds: market.clobTokenIds, side, entryPrice: ask.price,\n        size: shares, cost: size, openedAt: new Date().toISOString()\n      };\n      addPosition('momentum', pos);\n      logTrade({\n        ts: new Date().toISOString(), strategy: 'momentum', action: 'buy',\n        market: market.slug, side, price: ask.price, size,\n        reason: `${(change*100).toFixed(1)}% momentum over 3h+`\n      });\n      log('momentum', `BUY ${side} ${market.slug} momentum=${(change*100).toFixed(1)}%`);\n    } catch {}\n  }\n}\n\n// ─── Price History Collection ─────────────────────────────────────────────────\nasync function collectPrices() {\n  log('PRICES', 'Collecting price snapshots...');\n  const markets = await fetchActiveMarkets(true);\n  let count = 0;\n  const now = Math.floor(Date.now() / 1000);\n\n  for (const m of markets) {\n    try {\n      const tokenIds = JSON.parse(m.clobTokenIds);\n      for (const tid of tokenIds) {\n        const book = await fetchOrderBook(tid);\n        const mid = getMidPrice(book);\n        if (mid === null) continue;\n        if (!priceHistory[tid]) priceHistory[tid] = [];\n        priceHistory[tid].push({ t: now, p: mid });\n        count++;\n      }\n    } catch {}\n    // Small delay to be nice to API\n    if (count % 20 === 0) await sleep(100);\n  }\n\n  pruneHistory();\n  savePriceHistory();\n  log('PRICES', `Collected ${count} prices, ${Object.keys(priceHistory).length} tokens tracked`);\n}\n\n// ─── Resolution Tracking ─────────────────────────────────────────────────────\nasync function checkResolutions() {\n  log('RESOLUTION', 'Checking for resolved markets...');\n  \n  for (const stratName of STRATEGY_NAMES) {\n    const s = state.strategies[stratName];\n    for (let i = s.positions.length - 1; i >= 0; i--) {\n      const pos = s.positions[i];\n      const condId = pos.conditionId || pos.groupSlug;\n      if (!condId) continue;\n\n      try {\n        const r = await retryFetch(`${GAMMA_API}/markets?conditionId=${condId}`);\n        if (!r || !r.ok) continue;\n        const data = await r.json();\n        if (!data.length) continue;\n        const market = data[0];\n\n        if (market.closed && market.resolution !== undefined && market.resolution !== null) {\n          const resolution = market.resolution;\n          let settlePx;\n          \n          if (stratName === 'multi-outcome') {\n            // For multi-outcome, check which outcome won\n            settlePx = 0; // Default: lost\n            // Simplified: we get back $1 for winning outcome shares\n            const winningShares = pos.outcomes?.find(o => o.conditionId === condId);\n            if (resolution === 'Yes' || resolution === '1') {\n              settlePx = 1.0 / (pos.outcomes?.length || 1);\n            }\n          } else if (pos.side === 'BOTH') {\n            settlePx = 1.0; // Arb: always get $1 back per unit\n          } else {\n            const won = (pos.side === 'YES' && (resolution === 'Yes' || resolution === '1')) ||\n                        (pos.side === 'NO' && (resolution === 'No' || resolution === '0'));\n            settlePx = won ? 1.0 : 0.0;\n          }\n\n          closePosition(stratName, i, settlePx, `resolved: ${resolution}`);\n          log('RESOLUTION', `${stratName}: ${pos.market} resolved=${resolution} settle=${settlePx}`);\n        }\n      } catch {}\n    }\n  }\n  saveState();\n}\n\n// ─── Daily Report ─────────────────────────────────────────────────────────────\nfunction generateReport() {\n  log('REPORT', 'Generating daily report...');\n  const report = { generatedAt: new Date().toISOString(), strategies: {} };\n  let txt = `=== POLYMARKET MULTI-STRATEGY PAPER TRADING REPORT ===\\n`;\n  txt += `Generated: ${new Date().toISOString()}\\n`;\n  txt += `Started: ${state.startedAt}\\n\\n`;\n\n  const rankings = [];\n\n  for (const name of STRATEGY_NAMES) {\n    const s = state.strategies[name];\n    const openPositions = s.positions.length;\n    const closedTrades = s.trades.length;\n    const wins = s.trades.filter(t => t.profit > 0).length;\n    const winRate = closedTrades > 0 ? (wins / closedTrades * 100).toFixed(1) : 'N/A';\n    const realizedPnl = s.pnl;\n    const unrealizedPnl = 0; // Would need live prices, approximate as 0\n    const totalReturn = ((s.capital + realizedPnl - 1000) / 1000 * 100).toFixed(2);\n\n    report.strategies[name] = {\n      capital: s.capital, openPositions, closedTrades,\n      realizedPnl, unrealizedPnl, winRate, totalReturn\n    };\n\n    rankings.push({ name, totalReturn: parseFloat(totalReturn) });\n\n    txt += `── ${name.toUpperCase()} ──\\n`;\n    txt += `  Capital: $${s.capital.toFixed(2)}\\n`;\n    txt += `  Open Positions: ${openPositions}\\n`;\n    txt += `  Closed Trades: ${closedTrades}\\n`;\n    txt += `  Realized P&L: $${realizedPnl.toFixed(2)}\\n`;\n    txt += `  Win Rate: ${winRate}%\\n`;\n    txt += `  Total Return: ${totalReturn}%\\n\\n`;\n  }\n\n  rankings.sort((a, b) => b.totalReturn - a.totalReturn);\n  txt += `── RANKINGS ──\\n`;\n  rankings.forEach((r, i) => {\n    txt += `  ${i + 1}. ${r.name}: ${r.totalReturn}%\\n`;\n  });\n\n  report.rankings = rankings;\n  fs.writeFileSync(DAILY_REPORT_JSON, JSON.stringify(report, null, 2));\n  fs.writeFileSync(DAILY_REPORT_TXT, txt);\n  log('REPORT', 'Report saved');\n}\n\n// ─── Main Loop ────────────────────────────────────────────────────────────────\nasync function mainScanLoop() {\n  try {\n    const markets = await fetchActiveMarkets();\n    \n    // Run arb strategies (they share market scans but use different thresholds)\n    await runSimpleArb(markets);\n    await runSpreadTightening(markets);\n    \n    // Run directional strategies\n    await runMeanReversion(markets);\n    await runMomentum(markets);\n    \n    // Multi-outcome (less frequent, but check every scan)\n    await runMultiOutcome(markets);\n\n    saveState();\n  } catch (e) {\n    log('SYSTEM', 'Scan loop error:', e.message);\n  }\n}\n\nasync function main() {\n  log('SYSTEM', '🚀 Multi-Strategy Paper Trading System starting...');\n  log('SYSTEM', `Strategies: ${STRATEGY_NAMES.join(', ')}`);\n  \n  loadPriceHistory();\n  \n  // Initialize whale file offset\n  if (fs.existsSync(WHALE_FILE)) {\n    try {\n      const lines = fs.readFileSync(WHALE_FILE, 'utf8').trim().split('\\n');\n      lastWhaleOffset = lines.length;\n      log('whale-signal', `Starting from whale offset ${lastWhaleOffset}`);\n    } catch {}\n  }\n\n  // Print initial state\n  for (const name of STRATEGY_NAMES) {\n    const s = state.strategies[name];\n    log(name, `Capital: $${s.capital.toFixed(2)}, Positions: ${s.positions.length}, P&L: $${s.pnl.toFixed(2)}`);\n  }\n\n  // Initial price collection\n  await collectPrices();\n\n  // Generate initial report\n  generateReport();\n\n  // Main scan every 10s\n  setInterval(mainScanLoop, SCAN_INTERVAL);\n  \n  // Whale signal check every 30s\n  setInterval(async () => {\n    try {\n      const markets = await fetchActiveMarkets();\n      await runWhaleSignal(markets);\n      saveState();\n    } catch (e) {\n      log('whale-signal', 'Error:', e.message);\n    }\n  }, WHALE_CHECK_INTERVAL);\n\n  // Price collection every 5min\n  setInterval(collectPrices, PRICE_INTERVAL);\n\n  // Resolution check every hour\n  setInterval(checkResolutions, RESOLUTION_INTERVAL);\n\n  // Daily report\n  setInterval(generateReport, REPORT_INTERVAL);\n\n  // First scan immediately\n  await mainScanLoop();\n  \n  log('SYSTEM', '✅ All strategies running');\n}\n\nmain().catch(e => {\n  console.error('Fatal error:', e);\n  process.exit(1);\n});\n"}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-opus-4-5","usage":{"input":1,"output":10656,"cacheRead":13554,"cacheWrite":134,"totalTokens":24345,"cost":{"input":0.000005,"output":0.2664,"cacheRead":0.006777,"cacheWrite":0.0008375,"total":0.27401949999999997}},"stopReason":"toolUse","timestamp":1769916332850}}
