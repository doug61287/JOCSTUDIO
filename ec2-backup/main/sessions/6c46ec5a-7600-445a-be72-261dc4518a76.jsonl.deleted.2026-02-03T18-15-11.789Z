bid_source_finding\": \"Count of valves by type\",\n      \"document_validation\": {\n        \"valve_types\": [\n          \"OS&Y gate valves (2\\\", 4\\\", 6\\\", 8\\\", 10\\\")\",\n          \"Butterfly valves (4\\\", 6\\\", 8\\\") with tamper switch\",\n          \"Check valves at riser bases and pump discharge\",\n          \"Pressure-restricting hose valves (NPS 2-1/2\\\" and 1-1/2\\\")\",\n          \"Automatic ball drip valves (3/4\\\")\"\n        ],\n        \"manufacturers\": [\"Crane\", \"Grinnell\", \"Kennedy\", \"NIBCO\"],\n        \"standards\": \"UL listed, FM approved, NFPA 14 compliant\"\n      },\n      \"scope_match\": \"PARTIAL - valve counts not specified, need drawing takeoff\",\n      \"confidence\": \"MEDIUM\",\n      \"source_citations\": [\"Spec 21 05 04\", \"Spec 21 12 00 Section 2.04\"],\n      \"conflicts\": \"None\",\n      \"rfi_flag\": \"Request valve schedule with counts by type and size\"\n    },\n    \"item_46\": {\n      \"description\": \"21 05 05 Hangers, Supports and Anchors\",\n      \"unit\": \"LS\",\n      \"bid_source_finding\": \"All hangers, supports, seismic bracing\",\n      \"document_validation\": {\n        \"requirements\": \"NFPA compliant, seismic bracing per NYC Building Code\",\n        \"pump_support\": \"L3x3 double angle at fire pump equipment\",\n        \"hanger_spacing\": \"Per NFPA 13/14 (typically 10-12 ft for mains)\"\n      },\n      \"scope_match\": \"FULL MATCH\",\n      \"confidence\": \"HIGH\",\n      \"source_citations\": [\"Spec 21 05 05\"],\n      \"conflicts\": \"None\"\n    },\n    \"item_47\": {\n      \"description\": \"21 05 13 Common Motor Requirements\",\n      \"unit\": \"LS\",\n      \"bid_source_finding\": \"Fire pump motor specifications\",\n      \"document_validation\": {\n        \"motor_type\": \"UL-listed, NEMA MG 1, open-dripproof, squirrel-cage induction\",\n        \"compliance\": \"NFPA 20, NFPA 70\",\n        \"hp\": \"As listed on Design Drawings (not extracted)\"\n      },