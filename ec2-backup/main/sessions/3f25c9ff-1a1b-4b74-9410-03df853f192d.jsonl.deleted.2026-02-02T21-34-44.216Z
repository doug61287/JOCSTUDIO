n    \"20\": {\"qty\": 1, \"unit\": \"LS\", \"source_sheets\": [], \"notes\": \"Chases, Openings and Inserts\", \"confidence\": \"N/A\", \"category\": \"General Conditions\"},\n    \"21\": {\"qty\": 1, \"unit\": \"LS\", \"source_sheets\": [], \"notes\": \"Construction Waste Management and Disposal\", \"confidence\": \"N/A\", \"category\": \"General Conditions\"},\n    \"22\": {\"qty\": 1, \"unit\": \"LS\", \"source_sheets\": [], \"notes\": \"Closeout Procedures\", \"confidence\": \"N/A\", \"category\": \"General Conditions\"},\n    \"23\": {\"qty\": 1, \"unit\": \"LS\", \"source_sheets\": [], \"notes\": \"Operation and Maintenance Data\", \"confidence\": \"N/A\", \"category\": \"General Conditions\"},\n    \"24\": {\"qty\": 1, \"unit\": \"LS\", \"source_sheets\": [], \"notes\": \"Project Record Documents\", \"confidence\": \"N/A\", \"category\": \"General Conditions\"},\n    \"25\": {\"qty\": 1, \"unit\": \"LS\", \"source_sheets\": [], \"notes\": \"Demonstration and Training\", \"confidence\": \"N/A\", \"category\": \"General Conditions\"},\n    \"26\": {\"qty\": 1, \"unit\": \"LS\", \"source_sheets\": [\"AD-101\", \"C-050\"], \"notes\": \"Selective Demolition - demo of existing ambulance drop-off area (~3,200 SF): walls, ceilings, floors, doors, MEP, exterior wall sections. Weathering steel panels saved for reuse. Active hospital - ICRA/ILSM required.\", \"confidence\": \"HIGH\", \"category\": \"Existing Conditions\"},\n    \"27\": {\"qty\": 1, \"unit\": \"LS\", \"source_sheets\": [\"H-001\", \"H-101\"], \"notes\": \"Asbestos Removal - ACM abatement per environmental survey, must precede all demolition. NYC DEP compliance. Containment, negative air, monitoring, disposal.\", \"confidence\": \"MEDIUM\", \"category\": \"Existing Conditions\"},\n    \"28\": {\n      \"qty\": 592,\n      \"unit\": \"SF\",\n      \"source_sheets\": [\"A-101\", \"FO-101\", \"FO-200\", \"FO-300\"],\n      \"notes\": \"Concrete Work - 12\\\" SOG with #6@12 OC double mat, 4000 PSI. 5 rooms: Cart Wash (212 SF), Security Station (82 SF), NYPD Security Pickup (50 SF), Entrance Vestibule (207 SF), Cart Alcove (41 SF). Also includes pile caps (~12 CY), grade beams (~7 CY). SOG area = 592 SF.\",\n      \"confidence\": \"HIGH\",\n      \"category\": \"Concrete\"\n    },\n    \"29\": {\"qty\": 1, \"unit\": \"LS\", \"source_sheets\": [\"FO-200\", \"FO-201\"], \"notes\": \"Post Installed Anchors - connections to existing building structure at expansion joint and tie-in locations per structural details\", \"confidence\": \"MEDIUM\", \"category\": \"Concrete\"},\n    \"30\": {\n      \"qty\": 592,\n      \"unit\": \"SF\",\n      \"source_sheets\": [\"A-801\"],\n      \"notes\": \"Cast Underlayment - self-leveling underlayment over SOG for epoxy flooring. All 5 rooms receive poured epoxy (PE-1 or PE-2) requiring level substrate. Same area as SOG = 592 SF.\",\n      \"confidence\": \"MEDIUM\",\n      \"category\": \"Concrete\"\n    },\n    \"31\": {\n      \"qty\": 85,\n      \"unit\": \"LF\",\n      \"source_sheets\": [\"A-101\", \"A-201\", \"A-223\", \"A-224\"],\n      \"notes\": \"Unit Masonry - new brick veneer on CMU/CFMF to match existing. BES-05 brick on CFMF (~55 LF), BES-10 brick on CMU (~30 LF). Measured as linear feet of wall. Approximately 485 SF of masonry wall face area at ~5.7' avg exposed height = ~85 LF.\",\n      \"confidence\": \"MEDIUM\",\n      \"category\": \"Masonry\"\n    },\n    \"32\": {\n      \"qty\": 350,\n      \"unit\": \"LF\",\n      \"source_sheets\": [\"S-101\", \"S-200\", \"S-201\"],\n      \"notes\": \"Structural Steel Framing - canopy framing per S-101: W8x10 primary beams, W6x12 secondary, HSS6x2 members, C6x13 channels, L4x3.5 lintels. Total ~8,750 lbs / ~25 lbs per LF avg = ~350 LF. T.O.S. at EL 27'-0\\\". A992/A572 Gr50 steel.\",\n      \"confidence\": \"MEDIUM\",\n      \"category\": \"Metals\"\n    },\n    \"33\": {\"qty\": 1, \"unit\": \"LS\", \"source_sheets\": [\"A-701\", \"A-223\", \"A-224\"], \"notes\": \"Cold Formed Metal Framing - partition types include metal stud framing at all interior partitions and exterior backup walls. 3-5/8\\\" and 6\\\" studs at 16\\\" OC. BES-05 has 2x6 SS (metal stud equiv). Includes framing for GWB ceilings (C-2).\", \"confidence\": \"MEDIUM\", \"category\": \"Metals\"},\n    \"34\": {\"qty\": 1, \"unit\": \"LS\", \"source_sheets\": [\"S-101\", \"A-301\", \"A-302\"], \"notes\": \"Metal Fabrication - shelf angles (~145 LF), lintels (6 EA), HSS posts for storefront (4 EA), bollards (6 EA), misc brackets, canopy fascia/soffit framing (~78 LF perimeter), gutter supports (~42 LF).\", \"confidence\": \"MEDIUM\", \"category\": \"Metals\"},\n    \"35\": {\"qty\": 1, \"unit\": \"LS\", \"source_sheets\": [\"A-101\", \"A-702\"], \"notes\": \"Miscellaneous Rough Carpentry - ~200 BF fire-retardant treated lumber for blocking at storefront, equipment mounting, casework support. Most framing is CFMF.\", \"confidence\": \"LOW\", \"category\": \"Wood and Plastics\"},\n    \"36\": {\n      \"qty\": 485,\n      \"unit\": \"SF\",\n      \"source_sheets\": [\"A-223\", \"A-224\", \"EN-300\"],\n      \"notes\": \"Sheathing - 5/8\\\" DensGlass exterior sheathing at new exterior walls (BES-05, BES-08). Exterior wall area ~485 SF based on wall perimeter x height measurements from elevations A-201.\",\n      \"confidence\": \"MEDIUM\",\n      \"category\": \"Wood and Plastics\"\n    },\n    \"37\": {\"qty\": 1, \"unit\": \"LS\", \"source_sheets\": [\"A-702\", \"A-400\"], \"notes\": \"Architectural Woodwork - security desk with phenolic panels and solid surface countertop per A-702 details. ~28 LF total casework. Includes base cabinets, wall cabinets, transaction counter with pass-through.\", \"confidence\": \"LOW\", \"category\": \"Wood and Plastics\"},\n    \"38\": {\n      \"qty\": 592,\n      \"unit\": \"SF\",\n      \"source_sheets\": [\"A-223\", \"FO-200\"],\n      \"notes\": \"Self-Adhering Sheet Waterproofing - underslab waterproofing membrane at SOG (592 SF) plus foundation wall waterproofing (~285 SF) = ~877 SF total. BID ITEM QUANTITY = 592 SF for underslab only. Foundation wall WP may be separate.\",\n      \"confidence\": \"MEDIUM\",\n      \"category\": \"Thermal/Moisture\"\n    },\n    \"39\": {\n      \"qty\": 1170,\n      \"unit\": \"SF\",\n      \"source_sheets\": [\"A-223\", \"A-224\", \"EN-001\", \"EN-002\"],\n      \"notes\": \"Thermal Insulation - walls: 2\\\" polyiso R-8.5 (485 SF) + 3.5\\\" batt R-13 cavity (485 SF) = 970 SF walls. Slab edge R-15 (195 SF) + foundation wall R-7.5 (145 SF) excluded from wall calc but included in total. BID ITEM = ~1,170 SF counting wall insulation layers separately.\",\n      \"confidence\": \"MEDIUM\",\n      \"category\": \"Thermal/Moisture\"\n    },\n    \"40\": {\n      \"qty\": 485,\n      \"unit\": \"SF\",\n      \"source_sheets\": [\"A-223\", \"A-224\", \"EN-300\"],\n      \"notes\": \"Air Barriers - air/water-resistive barrier membrane at all new exterior walls. Same area as exterior sheathing = 485 SF. Applied over DensGlass sheathing per BES-05 and BES-08 wall assemblies.\",\n      \"confidence\": \"MEDIUM\",\n      \"category\": \"Thermal/Moisture\"\n    },\n    \"41\": {\n      \"qty\": 485,\n      \"unit\": \"SF\",\n      \"source_sheets\": [\"A-303\", \"A-501\"],\n      \"notes\": \"Fluid-Applied Protected Membrane Roofing - PMMA liquid-applied roofing at canopy. R-33 polyiso insulation (5.5\\\" min) + cover board + PMMA membrane. Canopy area ~37'x13' (~485 SF based on grid spacing). 1/4\\\"/ft slope to 4 roof drains.\",\n      \"confidence\": \"MEDIUM\",\n      \"category\": \"Thermal/Moisture\"\n    },\n    \"42\": {\"qty\": 1, \"unit\": \"LS\", \"source_sheets\": [\"A-303\", \"A-501\"], \"notes\": \"Roof Specialties - fascia/coping (~78 LF), gutters (~42 LF), roof edge flashing, expansion joint covers, skylight flashing (existing skylight to remain). Metal copings and fascia at canopy perimeter.\", \"confidence\": \"MEDIUM\", \"category\": \"Thermal/Moisture\"},\n    \"43\": {\"qty\": 1, \"unit\": \"LS\", \"source_sheets\": [\"S-200\", \"S-201\"], \"notes\": \"Applied Fire Protection - SFRM spray fireproofing on structural steel canopy members per code. Approximately 8,750 lbs of steel requiring fireproofing.\", \"confidence\": \"MEDIUM\", \"category\": \"Thermal/Moisture\"},\n    \"44\": {\"qty\": 1, \"unit\": \"LS\", \"source_sheets\": [\"A-701\"], \"notes\": \"Penetration Firestopping - all MEP penetrations through rated assemblies. Hospital occupancy requires strict compliance. Approximately 30-50 penetration locations.\", \"confidence\": \"MEDIUM\", \"category\": \"Thermal/Moisture\"},\n    \"45\": {\"qty\": 1, \"unit\": \"LS\", \"source_sheets\": [\"A-301\", \"A-302\"], \"notes\": \"Joint Sealants - storefront perimeters (165 LF), door frames (95 LF), control joints (125 LF), expansion joints (65 LF), roof joints (35 LF). Total ~485 LF.\", \"confidence\": \"MEDIUM\", \"category\": \"Thermal/Moisture\"},\n    \"46\": {\n      \"qty\": 2,\n      \"unit\": \"EA\",\n      \"source_sheets\": [\"A-701\"],\n      \"notes\": \"Hollow Metal Doors and Frames - 2 HM doors per door schedule: ED-1-01 (Cart Wash, 5'-0\\\"x7'-0\\\" single, HW set 1.0) and ED-1-09 (Entrance Vestibule, 6'-0\\\"x7'-0\\\" pair, no HW set listed). Both with TF finish on HM frames.\",\n      \"confidence\": \"HIGH\",\n      \"category\": \"Openings\"\n    },\n    \"47\": {\n      \"qty\": 6,\n      \"unit\": \"EA\",\n      \"source_sheets\": [\"A-501\"],\n      \"notes\": \"Access Doors and Panels - per RCP keynote C2: 'Contractor to provide metal door access panel as required for access to MEP units.' Note 10 on A-501: 'Access panels are not quantified or indicated on the drawings.' Estimated 6 EA based on MEP equipment locations (2 mechanical, 2 plumbing, 2 electrical). ⚠️ CONTRACTOR TO VERIFY IN FIELD.\",\n      \"confidence\": \"LOW\",\n      \"category\": \"Openings\"\n    },\n    \"48\": {\n      \"qty\": 3,\n      \"unit\": \"EA\",\n      \"source_sheets\": [\"A-101\", \"A-200\", \"A-704\"],\n      \"notes\": \"Aluminum-Framed Entrances and Storefronts - 3 storefront systems: (1) Exterior ballistic storefront at main entry with sliding doors ED-1-06 & ED-1-07, (2) Interior ballistic storefront at security station, (3) NYPD Security Pickup storefront. All thermally broken ballistic Level 3. BOD: US Bullet Proofing USAW400, Stanley Dura-Shield.\",\n      \"confidence\": \"MEDIUM\",\n      \"category\": \"Openings\"\n    },\n    \"49\": {\n      \"qty\": 375,\n      \"unit\": \"SF\",\n      \"source_sheets\": [\"A-701\", \"A-200\", \"A-704\"],\n      \"notes\": \"Glazing - all ballistic Level 3: ED-1-02 (27 SF), ED-1-03 (23 SF), ED-1-04 (23 SF), ED-1-06 sliding (115 SF), ED-1-07 sliding (115 SF), ED-1-08 (27 SF), storefront sidelites/transoms (~45 SF). Total ~375 SF. Excludes security glazing counted separately.\",\n      \"confidence\": \"MEDIUM\",\n      \"category\": \"Openings\"\n    },\n    \"50\": {\n      \"qty\": 110,\n      \"unit\": \"SF\",\n      \"source_sheets\": [\"A-101\", \"A-400\", \"A-704\"],\n      \"notes\": \"Security Glazing - additional security glazing at storefront sidelites, transaction windows, and fixed panels at security station and NYPD pickup beyond door glazing. Estimated from interior elevations A-400. ⚠️ VERIFY with security consultant MG Engineering.\",\n      \"confidence\": \"LOW\",\n      \"category\": \"Openings\"\n    },\n    \"51\": {\"qty\": 1, \"unit\": \"LS\", \"source_sheets\": [\"A-801\"], \"notes\": \"Common Work Results for Flooring Preparation - substrate prep for poured epoxy in all 5 rooms (592 SF total). Includes grinding, patching, moisture testing, primer.\", \"confidence\": \"HIGH\", \"category\": \"Finishes\"},\n    \"52\": {\n      \"qty\": 2850,\n      \"unit\": \"SF\",\n      \"source_sheets\": [\"A-101\", \"A-701\", \"A-801\"],\n      \"notes\": \"Gypsum Board Assemblies - 5/8\\\" Type X GWB on both sides of partitions + GWB ceilings (C-2). Walls: Cart Wash (496 SF), Security Station (260 SF), NYPD Pickup (200 SF), Vestibule (250 SF), Cart Alcove (247 SF) = 1,453 SF x2 sides ≈ 2,258 SF walls + 592 SF C-2 ceilings = ~2,850 SF. Includes soffits at vestibule.\",\n      \"confidence\": \"MEDIUM\",\n      \"category\": \"Finishes\"\n    },\n    \"53\": {\n      \"qty\": 145,\n      \"unit\": \"SF\",\n      \"source_sheets\": [\"A-801\", \"A-400\"],\n      \"notes\": \"Tiling - 2CM porcelain tile walls at Security Station only: PT/W-1 Silestone Cala Blue north wall (~65 SF), PT/W-2 Dekton Kreta south wall (~80 SF). Full height to 10' ceiling. Metal trim MT-1 at corners.\",\n      \"confidence\": \"MEDIUM\",\n      \"category\": \"Finishes\"\n    },\n    \"54\": {\"qty\": 1, \"unit\": \"LS\", \"source_sheets\": [\"A-801\", \"A-501\"], \"notes\": \"Acoustical Panel Ceiling - Armstrong 3214 Optima Health Beveled Tegular 24\\\"x24\\\", Prelude 15/16\\\" grid. C-1 in 3 rooms: Security Station (82 SF), NYPD Pickup (50 SF), Cart Alcove (41 SF) = 173 SF total. Correctional-grade secure type in patient-access areas.\", \"confidence\": \"HIGH\", \"category\": \"Finishes\"},\n    \"55\": {\n      \"qty\": 531,\n      \"unit\": \"SF\",\n      \"source_sheets\": [\"A-801\"],\n      \"notes\": \"Special Wall Surfacing - SWC-1 Stonhard Stonglaze VSR Ash Grey on ALL 4 walls of Cart Wash room. Perimeter ~59 LF x 9' height = 531 SF gross, less door opening (35 SF) = ~496 SF net. This is a special epoxy wall coating, not paint.\",\n      \"confidence\": \"MEDIUM\",\n      \"category\": \"Finishes\"\n    },\n    \"56\": {\n      \"qty\": 2100,\n      \"unit\": \"SF\",\n      \"source_sheets\": [\"A-801\"],\n      \"notes\": \"Painting and Coating - P-1 Benjamin Moore Epoxy (Mountain Peak White 2148-70) on walls: Security (175 SF), NYPD Pickup (230 SF), Vestibule (420 SF), Cart Alcove (182 SF) = 1,007 SF walls. P-2/P-3 on GWB ceilings (C-2): Cart Wash ceiling P-3 epoxy (212 SF) + Vestibule ceiling P-2 flat (207 SF) = 419 SF ceilings. Plus misc painting = ~2,100 SF total.\",\n      \"confidence\": \"MEDIUM\",\n      \"category\": \"Finishes\"\n    },\n    \"57\": {\n      \"qty\": 104,\n      \"unit\": \"SF\",\n      \"source_sheets\": [\"A-801\"],\n      \"notes\": \"Wall and Door Protection - PWP-1 INPRO Palladium White Sand, 60\\\" high, on N and S walls of Cart Alcove: 2 walls x 6'-3\\\" x 5'-0\\\" = ~63 SF. Corner guard CG-1. Plus door frame protection at HM doors. Total ~104 SF including both wall protection and incidental door protection.\",\n      \"confidence\": \"MEDIUM\",\n      \"category\": \"Finishes\"\n    },\n    \"58\": {\n      \"qty\": 250,\n      \"unit\": \"SF\",\n      \"source_sheets\": [\"A-701\", \"A-400\", \"A-704\"],\n      \"notes\": \"Ballistics Resistant Panels - 7/16\\\" fiberglass ballistic panels at partition types 7D/7E from floor to 4\\\" above ceiling. Vestibule/public side of security walls. Approximately 25 LF x 10' height = 250 SF. ⚠️ VERIFY exact wall lengths with A-101 dimensions.\",\n      \"confidence\": \"LOW\",\n      \"category\": \"Finishes\"\n    },\n    \"59\": {\n      \"qty\": 4,\n      \"unit\": \"SF\",\n      \"source_sheets\": [\"A-101\"],\n      \"notes\": \"Fire Protection Specialties - 4 EA fire extinguisher cabinets based on code travel distance requirements. Unit is listed as SF on bid sheet but this is likely EA (4 cabinets). ⚠️ CLARIFY UNIT with Owner - should be EA not SF. If SF, cabinet face area ~2 SF each = 8 SF.\",\n      \"confidence\": \"LOW\",\n      \"category\": \"Finishes\"\n    },\n    \"60\": {\n      \"qty\": 1,\n      \"unit\": \"EA\",\n      \"source_sheets\": [\"A-101\", \"G-004\"],\n      \"notes\": \"Removable Flood Barriers - 1 EA complete deployable flood barrier system: 2' high, Flood Risk America / Flood Defense Group EZ Flood Panels or equal. Located at ambulance bay entrance. Project is in flood zone per G-004. See structural drawings for embed details.\",\n      \"confidence\": \"HIGH\",\n      \"category\": \"Finishes\