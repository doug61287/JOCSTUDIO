{"type":"message","id":"1a918492","parentId":"1ac97179","timestamp":"2026-02-01T03:28:44.446Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"toolu_017sGo5whsUKYVbi7sF58ogz","name":"write","arguments":{"path":"/home/ec2-user/clawd/projects/lebbie-chocolates/index.html","content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Lebbie's Luxury Chocolates — Single-Origin Sierra Leonean Cocoa, Handcrafted in Baltimore</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Lato:wght@300;400;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap\" rel=\"stylesheet\">\n<style>\n*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }\n\n:root {\n  --chocolate: #2C1810;\n  --chocolate-medium: #4A2C2A;\n  --chocolate-light: #6B3A2A;\n  --gold: #C6A664;\n  --gold-light: #D4BC82;\n  --gold-bright: #E8D5A3;\n  --cream: #FDF8F0;\n  --cream-dark: #F5EDE0;\n  --ivory: #FFFEF9;\n  --text: #3A2218;\n  --text-light: #7A6458;\n}\n\nhtml { scroll-behavior: smooth; }\n\nbody {\n  font-family: 'Lato', sans-serif;\n  color: var(--text);\n  background: var(--cream);\n  line-height: 1.7;\n  font-weight: 300;\n  overflow-x: hidden;\n}\n\nh1, h2, h3, h4 { font-family: 'Playfair Display', serif; font-weight: 400; }\n\n.fade-in {\n  opacity: 0;\n  transform: translateY(30px);\n  transition: opacity 0.8s ease, transform 0.8s ease;\n}\n.fade-in.visible {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n/* ═══ NAVIGATION ═══ */\nnav {\n  position: fixed; top: 0; left: 0; right: 0; z-index: 100;\n  background: rgba(44, 24, 16, 0.95);\n  backdrop-filter: blur(10px);\n  padding: 1rem 2rem;\n  display: flex; justify-content: space-between; align-items: center;\n  border-bottom: 1px solid rgba(198, 166, 100, 0.3);\n}\nnav .logo {\n  font-family: 'Playfair Display', serif;\n  color: var(--gold);\n  font-size: 1.2rem;\n  letter-spacing: 2px;\n}\nnav .nav-links { display: flex; gap: 2rem; list-style: none; }\nnav .nav-links a {\n  color: var(--gold-light);\n  text-decoration: none;\n  font-size: 0.85rem;\n  letter-spacing: 1.5px;\n  text-transform: uppercase;\n  transition: color 0.3s;\n}\nnav .nav-links a:hover { color: #fff; }\n\n@media (max-width: 768px) {\n  nav .nav-links { gap: 1rem; }\n  nav .nav-links a { font-size: 0.7rem; letter-spacing: 1px; }\n}\n\n/* ═══ HERO ═══ */\n.hero {\n  min-height: 100vh;\n  display: flex; flex-direction: column; justify-content: center; align-items: center;\n  text-align: center;\n  background: linear-gradient(170deg, var(--chocolate) 0%, #1a0f0a 40%, var(--chocolate-medium) 100%);\n  position: relative;\n  padding: 2rem;\n  overflow: hidden;\n}\n.hero::before {\n  content: '';\n  position: absolute; inset: 0;\n  background:\n    radial-gradient(ellipse at 20% 50%, rgba(198, 166, 100, 0.08) 0%, transparent 60%),\n    radial-gradient(ellipse at 80% 30%, rgba(198, 166, 100, 0.05) 0%, transparent 50%);\n}\n.hero-content { position: relative; z-index: 1; max-width: 800px; }\n.hero-ornament {\n  color: var(--gold);\n  font-size: 2rem;\n  letter-spacing: 12px;\n  margin-bottom: 2rem;\n  opacity: 0.7;\n}\n.hero h1 {\n  font-size: clamp(2.5rem, 6vw, 4.5rem);\n  color: var(--cream);\n  letter-spacing: 4px;\n  margin-bottom: 0.5rem;\n  line-height: 1.2;\n}\n.hero h1 span {\n  display: block;\n  font-family: 'Cormorant Garamond', serif;\n  font-style: italic;\n  font-size: 0.45em;\n  color: var(--gold);\n  letter-spacing: 6px;\n  margin-top: 0.5rem;\n}\n.hero-tagline {\n  color: var(--gold-light);\n  font-size: clamp(0.9rem, 2vw, 1.15rem);\n  letter-spacing: 3px;\n  text-transform: uppercase;\n  margin: 2rem 0;\n  font-weight: 300;\n}\n.hero-divider {\n  width: 60px; height: 1px;\n  background: var(--gold);\n  margin: 2rem auto;\n  opacity: 0.6;\n}\n.hero-sub {\n  color: rgba(253, 248, 240, 0.7);\n  font-size: 1rem;\n  max-width: 500px;\n  margin: 0 auto;\n  font-style: italic;\n  font-family: 'Cormorant Garamond', serif;\n  font-size: 1.2rem;\n}\n\n/* ═══ SECTION STYLES ═══ */\nsection { padding: clamp(4rem, 10vw, 8rem) clamp(1.5rem, 5vw, 4rem); }\n\n.section-label {\n  text-transform: uppercase;\n  letter-spacing: 4px;\n  font-size: 0.75rem;\n  color: var(--gold);\n  text-align: center;\n  margin-bottom: 1rem;\n}\n.section-title {\n  font-size: clamp(2rem, 4vw, 3rem);\n  text-align: center;\n  margin-bottom: 1rem;\n  color: var(--chocolate);\n}\n.section-divider {\n  width: 40px; height: 1px;\n  background: var(--gold);\n  margin: 0 auto 3rem;\n}\n\n/* ═══ ORIGIN STORY ═══ */\n.origin {\n  background: var(--ivory);\n  max-width: 100%;\n}\n.origin-content {\n  max-width: 750px;\n  margin: 0 auto;\n  text-align: center;\n}\n.origin-content p {\n  margin-bottom: 1.5rem;\n  font-size: 1.05rem;\n  color: var(--text-light);\n  line-height: 1.9;\n}\n.origin-content .highlight {\n  font-family: 'Cormorant Garamond', serif;\n  font-style: italic;\n  font-size: 1.5rem;\n  color: var(--chocolate-medium);\n  margin: 2.5rem 0;\n  line-height: 1.6;\n}\n.origin-beans {\n  display: flex;\n  justify-content: center;\n  gap: 3rem;\n  margin-top: 3rem;\n  flex-wrap: wrap;\n}\n.origin-bean {\n  text-align: center;\n}\n.origin-bean .icon {\n  font-size: 2rem;\n  margin-bottom: 0.5rem;\n  display: block;\n}\n.origin-bean .label {\n  font-size: 0.75rem;\n  text-transform: uppercase;\n  letter-spacing: 2px;\n  color: var(--text-light);\n}\n\n/* ═══ COLLECTIONS ═══ */\n.collections {\n  background: var(--chocolate);\n  color: var(--cream);\n}\n.collections .section-title { color: var(--cream); }\n.collections .section-label { color: var(--gold); }\n\n.collection-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n  gap: 2rem;\n  max-width: 1200px;\n  margin: 0 auto;\n}\n.collection-card {\n  border: 1px solid rgba(198, 166, 100, 0.2);\n  border-radius: 2px;\n  overflow: hidden;\n  transition: border-color 0.4s, transform 0.4s;\n}\n.collection-card:hover {\n  border-color: var(--gold);\n  transform: translateY(-4px);\n}\n.card-image {\n  height: 220px;\n  display: flex; align-items: center; justify-content: center;\n  font-size: 3.5rem;\n  position: relative;\n}\n.card-image::after {\n  content: '';\n  position: absolute; bottom: 0; left: 0; right: 0;\n  height: 60px;\n  background: linear-gradient(transparent, rgba(44, 24, 16, 0.8));\n}\n\n.salone-bg {\n  background: linear-gradient(135deg, #2d5016 0%, #1a3a0a 30%, #4a7a2e 60%, #2d5016 100%);\n}\n.paris-bg {\n  background: linear-gradient(135deg, #4a3060 0%, #2a1840 30%, #6a4a80 60%, #3a2050 100%);\n}\n.milan-bg {\n  background: linear-gradient(135deg, #5a3a1a 0%, #3a2410 30%, #7a5a3a 60%, #4a2a14 100%);\n}\n.bmore-bg {\n  background: linear-gradient(135deg, #8a2a0a 0%, #5a1a06 30%, #aa4a2a 60%, #6a2010 100%);\n}\n\n.card-body { padding: 1.5rem; }\n.card-body h3 {\n  font-size: 1.4rem;\n  margin-bottom: 0.25rem;\n  color: var(--gold);\n}\n.card-body .card-subtitle {\n  font-family: 'Cormorant Garamond', serif;\n  font-style: italic;\n  color: var(--gold-light);\n  font-size: 0.95rem;\n  margin-bottom: 1rem;\n}\n.card-body p {\n  font-size: 0.9rem;\n  color: rgba(253, 248, 240, 0.7);\n  line-height: 1.7;\n  margin-bottom: 1rem;\n}\n.card-flavors {\n  display: flex; flex-wrap: wrap; gap: 0.5rem;\n}\n.flavor-tag {\n  font-size: 0.7rem;\n  text-transform: uppercase;\n  letter-spacing: 1.5px;\n  padding: 0.3rem 0.8rem;\n  border: 1px solid rgba(198, 166, 100, 0.3);\n  color: var(--gold-light);\n  border-radius: 1px;\n}\n.card-price {\n  display: block;\n  margin-top: 1rem;\n  font-family: 'Playfair Display', serif;\n  color: var(--gold);\n  font-size: 1.1rem;\n}\n\n/* ═══ THE MAKER ═══ */\n.maker {\n  background: var(--cream-dark);\n}\n.maker-content {\n  max-width: 900px;\n  margin: 0 auto;\n  display: grid;\n  grid-template-columns: 1fr 1.5fr;\n  gap: 4rem;\n  align-items: center;\n}\n.maker-portrait {\n  aspect-ratio: 3/4;\n  background: linear-gradient(135deg, var(--chocolate) 0%, var(--chocolate-medium) 50%, var(--chocolate-light) 100%);\n  border-radius: 2px;\n  display: flex; flex-direction: column;\n  align-items: center; justify-content: center;\n  color: var(--gold);\n  font-size: 4rem;\n  position: relative;\n  overflow: hidden;\n}\n.maker-portrait::after {\n  content: 'Photo Coming Soon';\n  position: absolute;\n  bottom: 1.5rem;\n  font-family: 'Cormorant Garamond', serif;\n  font-style: italic;\n  font-size: 0.85rem;\n  color: var(--gold-light);\n  letter-spacing: 1px;\n}\n.maker-text h3 {\n  font-size: 1.8rem;\n  margin-bottom: 1.5rem;\n  color: var(--chocolate);\n}\n.maker-text p {\n  margin-bottom: 1.2rem;\n  color: var(--text-light);\n  font-size: 1rem;\n  line-height: 1.8;\n}\n.maker-credentials {\n  margin-top: 2rem;\n  display: flex; flex-direction: column; gap: 0.8rem;\n}\n.credential {\n  display: flex; align-items: center; gap: 0.8rem;\n  font-size: 0.85rem;\n  color: var(--text-light);\n}\n.credential .icon { font-size: 1.2rem; }\n\n@media (max-width: 768px) {\n  .maker-content {\n    grid-template-columns: 1fr;\n    gap: 2rem;\n  }\n  .maker-portrait { max-width: 300px; margin: 0 auto; }\n}\n\n/* ═══ PROCESS ═══ */\n.process {\n  background: var(--ivory);\n}\n.process-steps {\n  display: flex;\n  justify-content: center;\n  gap: 2rem;\n  max-width: 1000px;\n  margin: 0 auto;\n  flex-wrap: wrap;\n}\n.process-step {\n  text-align: center;\n  flex: 1;\n  min-width: 200px;\n  max-width: 240px;\n}\n.step-icon {\n  font-size: 2.5rem;\n  margin-bottom: 1rem;\n  display: block;\n}\n.step-number {\n  font-family: 'Playfair Display', serif;\n  font-size: 0.75rem;\n  letter-spacing: 3px;\n  color: var(--gold);\n  text-transform: uppercase;\n  margin-bottom: 0.5rem;\n}\n.process-step h4 {\n  font-size: 1.1rem;\n  margin-bottom: 0.5rem;\n  color: var(--chocolate);\n}\n.process-step p {\n  font-size: 0.85rem;\n  color: var(--text-light);\n  line-height: 1.7;\n}\n\n/* ═══ WAITLIST ═══ */\n.waitlist {\n  background: linear-gradient(170deg, var(--chocolate) 0%, #1a0f0a 100%);\n  text-align: center;\n  color: var(--cream);\n}\n.waitlist .section-title { color: var(--cream); }\n.waitlist-subtitle {\n  font-family: 'Cormorant Garamond', serif;\n  font-style: italic;\n  font-size: 1.2rem;\n  color: var(--gold-light);\n  max-width: 500px;\n  margin: 0 auto 2.5rem;\n}\n.waitlist-form {\n  display: flex;\n  max-width: 480px;\n  margin: 0 auto;\n  gap: 0;\n}\n.waitlist-form input {\n  flex: 1;\n  padding: 1rem 1.5rem;\n  border: 1px solid rgba(198, 166, 100, 0.4);\n  border-right: none;\n  background: rgba(255, 255, 255, 0.05);\n  color: var(--cream);\n  font-family: 'Lato', sans-serif;\n  font-size: 0.9rem;\n  outline: none;\n  transition: border-color 0.3s;\n}\n.waitlist-form input::placeholder { color: rgba(253, 248, 240, 0.4); }\n.waitlist-form input:focus { border-color: var(--gold); }\n.waitlist-form button {\n  padding: 1rem 2rem;\n  background: var(--gold);\n  color: var(--chocolate);\n  border: 1px solid var(--gold);\n  font-family: 'Lato', sans-serif;\n  font-size: 0.8rem;\n  letter-spacing: 2px;\n  text-transform: uppercase;\n  cursor: pointer;\n  transition: all 0.3s;\n  font-weight: 700;\n}\n.waitlist-form button:hover {\n  background: var(--gold-light);\n}\n.waitlist-note {\n  margin-top: 1.5rem;\n  font-size: 0.8rem;\n  color: rgba(253, 248, 240, 0.4);\n}\n.waitlist-success {\n  display: none;\n  font-family: 'Cormorant Garamond', serif;\n  font-style: italic;\n  font-size: 1.3rem;\n  color: var(--gold);\n  margin-top: 1rem;\n}\n\n@media (max-width: 500px) {\n  .waitlist-form { flex-direction: column; }\n  .waitlist-form input { border-right: 1px solid rgba(198, 166, 100, 0.4); border-bottom: none; }\n}\n\n/* ═══ FOOTER ═══ */\nfooter {\n  background: #0f0906;\n  color: rgba(253, 248, 240, 0.5);\n  text-align: center;\n  padding: 3rem 2rem;\n}\n.footer-brand {\n  font-family: 'Playfair Display', serif;\n  color: var(--gold);\n  font-size: 1rem;\n  letter-spacing: 3px;\n  margin-bottom: 1.5rem;\n}\n.footer-links {\n  display: flex; justify-content: center; gap: 2rem;\n  margin-bottom: 1.5rem;\n  list-style: none;\n}\n.footer-links a {\n  color: rgba(253, 248, 240, 0.4);\n  text-decoration: none;\n  font-size: 0.8rem;\n  letter-spacing: 1px;\n  transition: color 0.3s;\n}\n.footer-links a:hover { color: var(--gold); }\n.footer-copy {\n  font-size: 0.75rem;\n  color: rgba(253, 248, 240, 0.25);\n}\n\n/* ═══ SCROLL INDICATOR ═══ */\n.scroll-hint {\n  position: absolute;\n  bottom: 2rem;\n  left: 50%;\n  transform: translateX(-50%);\n  color: var(--gold);\n  opacity: 0.5;\n  animation: bounce 2s infinite;\n  font-size: 1.5rem;\n}\n@keyframes bounce {\n  0%, 20%, 50%, 80%, 100% { transform: translateX(-50%) translateY(0); }\n  40% { transform: translateX(-50%) translateY(-10px); }\n  60% { transform: translateX(-50%) translateY(-5px); }\n}\n</style>\n</head>\n<body>\n\n<!-- Navigation -->\n<nav>\n  <div class=\"logo\">LEBBIE'S</div>\n  <ul class=\"nav-links\">\n    <li><a href=\"#origin\">Origin</a></li>\n    <li><a href=\"#collections\">Collections</a></li>\n    <li><a href=\"#maker\">The Maker</a></li>\n    <li><a href=\"#waitlist\">Waitlist</a></li>\n  </ul>\n</nav>\n\n<!-- Hero -->\n<section class=\"hero\">\n  <div class=\"hero-content\">\n    <div class=\"hero-ornament\">✦ ✦ ✦</div>\n    <h1>\n      Lebbie's Luxury Chocolates\n      <span>Single-Origin · Handcrafted · Extraordinary</span>\n    </h1>\n    <p class=\"hero-tagline\">Sierra Leonean Cocoa · European Craft · Baltimore Made</p>\n    <div class=\"hero-divider\"></div>\n    <p class=\"hero-sub\">Born in the cocoa hills of West Africa. Refined in the ateliers of Milan and Paris. Finished by hand in Baltimore.</p>\n  </div>\n  <div class=\"scroll-hint\">↓</div>\n</section>\n\n<!-- Origin Story -->\n<section class=\"origin\" id=\"origin\">\n  <div class=\"fade-in\">\n    <p class=\"section-label\">Our Story</p>\n    <h2 class=\"section-title\">From Freetown to Your Doorstep</h2>\n    <div class=\"section-divider\"></div>\n    <div class=\"origin-content\">\n      <p>It begins in the green hills outside Freetown, Sierra Leone — where cocoa trees grow in the shade of mango and palm, tended by farmers whose families have cultivated these beans for generations. The soil here is ancient. The flavors are unlike anything else on earth.</p>\n      <p class=\"highlight\">\"I didn't discover chocolate in a shop. I discovered it in the hills where it grows, from the hands of the people who grow it.\"</p>\n      <p>After five years living and working in Sierra Leone — building hospitals, forging friendships, falling in love with a country most people only see in headlines — the journey led to the pastry schools of Europe. First Milan, at the legendary FBM Boscolo, learning the Italian tradition of precision and depth. Then Paris, at Ferrandi, where chocolate becomes art.</p>\n      <p>Every bon bon we make carries that entire journey. The beans of Sierra Leone. The technique of Europe. The love of a place that changed everything.</p>\n      <div class=\"origin-beans\">\n        <div class=\"origin-bean\">\n          <span class=\"icon\">🌱</span>\n          <span class=\"label\">Single Origin</span>\n        </div>\n        <div class=\"origin-bean\">\n          <span class=\"icon\">🤲</span>\n          <span class=\"label\">Hand Selected</span>\n        </div>\n        <div class=\"origin-bean\">\n          <span class=\"icon\">✨</span>\n          <span class=\"label\">Small Batch</span>\n        </div>\n        <div class=\"origin-bean\">\n          <span class=\"icon\">🍫</span>\n          <span class=\"label\">European Craft</span>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- Collections -->\n<section class=\"collections\" id=\"collections\">\n  <div class=\"fade-in\">\n    <p class=\"section-label\">The Collections</p>\n    <h2 class=\"section-title\">Four Stories, One Origin</h2>\n    <div class=\"section-divider\"></div>\n    <div class=\"collection-grid\">\n\n      <!-- Salone Collection -->\n      <div class=\"collection-card\">\n        <div class=\"card-image salone-bg\">🌴</div>\n        <div class=\"card-body\">\n          <h3>The Salone Collection</h3>\n          <p class=\"card-subtitle\">Where it all begins</p>\n          <p>A love letter to Sierra Leone. Tropical fruit ganaches, palm wine caramel, fiery ginger, and coconut — the flavors of the country that started everything.</p>\n          <div class=\"card-flavors\">\n            <span class=\"flavor-tag\">Mango Passion</span>\n            <span class=\"flavor-tag\">Palm Wine</span>\n            <span class=\"flavor-tag\">Ginger Fire</span>\n            <span class=\"flavor-tag\">Coconut Dream</span>\n          </div>\n          <span class=\"card-price\">Box of 9 — $38</span>\n        </div>\n      </div>\n\n      <!-- Paris Collection -->\n      <div class=\"collection-card\">\n        <div class=\"card-image paris-bg\">🗼</div>\n        <div class=\"card-body\">\n          <h3>The Paris Collection</h3>\n          <p class=\"card-subtitle\">L'art du chocolat</p>\n          <p>Lessons from Ferrandi, distilled into nine perfect bites. Provençal lavender, rosé champagne, vanilla crème brûlée — the French tradition, with Sierra Leonean soul.</p>\n          <div class=\"card-flavors\">\n            <span class=\"flavor-tag\">Lavender</span>\n            <span class=\"flavor-tag\">Champagne Rosé</span>\n            <span class=\"flavor-tag\">Crème Brûlée</span>\n            <span class=\"flavor-tag\">Rose & Raspberry</span>\n          </div>\n          <span class=\"card-price\">Box of 9 — $42</span>\n        </div>\n      </div>\n\n      <!-- Milan Collection -->\n      <div class=\"collection-card\">\n        <div class=\"card-image milan-bg\">🏛</div>\n        <div class=\"card-body\">\n          <h3>The Milano Collection</h3>\n          <p class=\"card-subtitle\">Artigianale italiano</p>\n          <p>The Italian school taught precision and boldness. Rich espresso ganache, bitter amaretto, toasted Piedmont hazelnut — gianduja the way it was meant to be.</p>\n          <div class=\"card-flavors\">\n            <span class=\"flavor-tag\">Espresso</span>\n            <span class=\"flavor-tag\">Amaretto</span>\n            <span class=\"flavor-tag\">Hazelnut</span>\n            <span class=\"flavor-tag\">Gianduja</span>\n          </div>\n          <span class=\"card-price\">Box of 9 — $42</span>\n        </div>\n      </div>\n\n      <!-- Baltimore Collection -->\n      <div class=\"collection-card\">\n        <div class=\"card-image bmore-bg\">🦀</div>\n        <div class=\"card-body\">\n          <h3>The Charm City Collection</h3>\n          <p class=\"card-subtitle\">Baltimore, hon</p>\n          <p>Home is where the heart is. Old Bay–kissed salted caramel, Berger cookie ganache, Chesapeake honey, and black walnut — Baltimore in a box.</p>\n          <div class=\"card-flavors\">\n            <span class=\"flavor-tag\">Old Bay Caramel</span>\n            <span class=\"flavor-tag\">Berger Cookie</span>\n            <span class=\"flavor-tag\">Local Honey</span>\n            <span class=\"flavor-tag\">Black Walnut</span>\n          </div>\n          <span class=\"card-price\">Box of 9 — $38</span>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<!-- Process -->\n<section class=\"process\">\n  <div class=\"fade-in\">\n    <p class=\"section-label\">The Craft</p>\n    <h2 class=\"section-title\">Every Detail, By Hand</h2>\n    <div class=\"section-divider\"></div>\n    <div class=\"process-steps\">\n      <div class=\"process-step\">\n        <span class=\"step-icon\">🌍</span>\n        <p class=\"step-number\">Step One</p>\n        <h4>Source</h4>\n        <p>Single-origin cocoa beans, selected directly from farming communities in Sierra Leone.</p>\n      </div>\n      <div class=\"process-step\">\n        <span class=\"step-icon\">🔥</span>\n        <p class=\"step-number\">Step Two</p>\n        <h4>Roast & Temper</h4>\n        <p>Small-batch roasting to unlock the unique terroir, then precision tempering for perfect snap and sheen.</p>\n      </div>\n      <div class=\"process-step\">\n        <span class=\"step-icon\">🎨</span>\n        <p class=\"step-number\">Step Three</p>\n        <h4>Fill & Finish</h4>\n        <p>Hand-piped ganaches, caramels, and pralinés — each bon bon finished and decorated by hand.</p>\n      </div>\n      <div class=\"process-step\">\n        <span class=\"step-icon\">🎁</span>\n        <p class=\"step-number\">Step Four</p>\n        <h4>Gift</h4>\n        <p>Packaged in elegant boxes, ready to be given, shared, and savored.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- The Maker -->\n<section class=\"maker\" id=\"maker\">\n  <div class=\"fade-in\">\n    <p class=\"section-label\">The Maker</p>\n    <h2 class=\"section-title\">Meet Doug</h2>\n    <div class=\"section-divider\"></div>\n    <div class=\"maker-content\">\n      <div class=\"maker-portrait\">📸</div>\n      <div class=\"maker-text\">\n        <h3>Builder. Photographer. Chocolatier.</h3>\n        <p>Doug spent five years in Sierra Leone with Partners In Health, building hospitals from the ground up. As a construction project manager, he learned to turn raw materials into something that saves lives. Somewhere along the way, he discovered that the same hands could do something else extraordinary — turn raw cocoa into art.</p>\n        <p>Between building sites and community visits, he fell in love with the cocoa that grew everywhere around him. He photographed the farms. He talked to the farmers. And when the time came, he traveled to FBM Boscolo in Milan and Ferrandi in Paris to learn the European art of chocolate making.</p>\n        <p>Now based in Baltimore, Doug brings it all together — the beans he knows by name, the techniques of the Old World, and the story of a country that deserves to be known for its extraordinary cocoa.</p>\n        <div class=\"maker-credentials\">\n          <div class=\"credential\"><span class=\"icon\">🎓</span> FBM Boscolo, Milan — Chocolate & Pastry</div>\n          <div class=\"credential\"><span class=\"icon\">🎓</span> Ferrandi Paris — Advanced Confections</div>\n          <div class=\"credential\"><span class=\"icon\">🏥</span> 5 Years — Partners In Health, Sierra Leone</div>\n          <div class=\"credential\"><span class=\"icon\">📷</span> Award-Winning Photographer</div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<!-- Waitlist -->\n<section class=\"waitlist\" id=\"waitlist\">\n  <div class=\"fade-in\">\n    <p class=\"section-label\">Coming Soon</p>\n    <h2 class=\"section-title\">Join the Waitlist</h2>\n    <div class=\"section-divider\"></div>\n    <p class=\"waitlist-subtitle\">Be the first to know when our collections launch. Early supporters receive a complimentary tasting box.</p>\n    <form class=\"waitlist-form\" onsubmit=\"handleSubmit(event)\">\n      <input type=\"email\" placeholder=\"Your email address\" required>\n      <button type=\"submit\">Notify Me</button>\n    </form>\n    <p class=\"waitlist-note\">No spam, ever. Just chocolate news.</p>\n    <p class=\"waitlist-success\" id=\"success-msg\">✦ You're on the list. Beautiful things are coming. ✦</p>\n  </div>\n</section>\n\n<!-- Footer -->\n<footer>\n  <div class=\"footer-brand\">LEBBIE'S LUXURY CHOCOLATES</div>\n  <ul class=\"footer-links\">\n    <li><a href=\"#\">Instagram</a></li>\n    <li><a href=\"#\">Contact</a></li>\n    <li><a href=\"#\">Our Story</a></li>\n    <li><a href=\"#\">Press</a></li>\n  </ul>\n  <p class=\"footer-copy\">© 2025 Lebbie's Luxury Chocolates · Baltimore, MD · Single-origin Sierra Leonean cocoa, handcrafted with love.</p>\n</footer>\n\n<script>\n// Fade-in on scroll\nconst observer = new IntersectionObserver((entries) => {\n  entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); } });\n}, { threshold: 0.15 });\ndocument.querySelectorAll('.fade-in').forEach(el => observer.observe(el));\n\n// Waitlist form\nfunction handleSubmit(e) {\n  e.preventDefault();\n  e.target.style.display = 'none';\n  document.getElementById('success-msg').style.display = 'block';\n}\n\n// Hide scroll hint on scroll\nwindow.addEventListener('scroll', () => {\n  const hint = document.querySelector('.scroll-hint');\n  if (hint && window.scrollY > 100) hint.style.opacity = '0';\n}, { passive: true });\n</script>\n\n</body>\n</html>\n"}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-opus-4-5","usage":{"input":1,"output":8812,"cacheRead":11074,"cacheWrite":1883,"totalTokens":21770,"cost":{"input":0.000005,"output":0.22030000000000002,"cacheRead":0.005536999999999999,"cacheWrite":0.01176875,"total":0.23761075}},"stopReason":"toolUse","timestamp":1769916417253}}
