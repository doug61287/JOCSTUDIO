4-7/8\\\"\",\n      \"notes\": \"CORRESPONDS TO BID ITEM 50 (W32 non-rated). Type designation uncertain - could be W3 or W2 without fire rating variant. VERIFY from original.\"\n    },\n    {\n      \"type\": \"W4\",\n      \"description\": \"Wall with 6\\\" studs\",\n      \"stud_size\": \"6\\\"\",\n      \"stud_spacing\": \"16\\\" O.C.\",\n      \"max_height\": \"24'-7\\\"\",\n      \"gwb_side_1\": \"1 layer 5/8\\\" GWB\",\n      \"gwb_side_2\": \"1 layer 5/8\\\" GWB\",\n      \"insulation\": \"Not specified\",\n      \"fire_rating\": \"None\",\n      \"total_thickness\": \"7-1/4\\\" (estimated)\",\n      \"notes\": \"CORRESPONDS TO BID ITEM 53 (W62 - 6\\\" studs). Used for plumbing walls or structural requirements.\"\n    },\n    {\n      \"type\": \"F1\",\n      \"description\": \"Furring - 1 side GWB on existing wall (INFERRED from bid item 52)\",\n      \"stud_size\": \"2-1/2\\\"\",\n      \"stud_spacing\": \"16\\\" O.C.\",\n      \"gwb_side_1\": \"1 layer 5/8\\\" GWB\",\n      \"gwb_side_2\": \"None (existing wall)\",\n      \"insulation\": \"2\\\" batt\",\n      \"fire_rating\": \"None\",\n      \"total_thickness\": \"3-1/8\\\" (furring depth)\",\n      \"notes\": \"CORRESPONDS TO BID ITEM 52 (F21). This is a furring/chase wall on one side of existing construction. VERIFY type designation.\"\n    },\n    {\n      \"type\": \"C00\",\n      \"description\": \"CMU wall\",\n      \"stud_size\": \"N/A - 6\\\" CMU\",\n      \"stud_spacing\": \"N/A\",\n      \"max_height\": \"16'-0\\\"\",\n      \"gwb_side_1\": \"None indicated\",\n      \"gwb_side_2\": \"None indicated\",\n      \"insulation\": \"N/A\",\n      \"fire_rating\": \"Non-load bearing (inherent fire resistance of CMU)\",\n      \"total_thickness\": \"5-5/8\\\" (nominal 6\\\" CMU)\",\n      \"notes\": \"CORRESPONDS TO BID ITEM 25 (6\\\" masonry infill). New CMU infill at selected locations.\"\n    }\n  ],\n  \"bid_crossref\": {\n    \"item_50\": {\n      \"description\": \"Interior Partitions W32 - 3 5/8