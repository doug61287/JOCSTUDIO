{"type":"message","id":"4b7fd2ab","parentId":"6500ceb1","timestamp":"2026-02-01T23:12:16.922Z","message":{"role":"assistant","content":[{"type":"text","text":"Got the API key. Now I'll build everything."},{"type":"toolCall","id":"toolu_016g36BZfzA8uAmTnpTwhCvb","name":"write","arguments":{"path":"/home/ec2-user/clawd/scripts/scout-joc-leads.js","content":"#!/usr/bin/env node\n/**\n * Scout JOC Lead Scraper\n * Searches for publicly awarded Job Order Contracting (JOC) contracts\n * and builds a lead list of contractors.\n */\n\nconst https = require('https');\nconst http = require('http');\nconst fs = require('fs');\nconst path = require('path');\n\n// --- Config ---\nconst BRAVE_API_KEY = process.env.BRAVE_API_KEY || (() => {\n  try {\n    const cfg = JSON.parse(fs.readFileSync(\n      path.join(process.env.HOME, '.clawdbot', 'clawdbot.json'), 'utf8'\n    ));\n    return cfg?.tools?.web?.search?.apiKey;\n  } catch { return null; }\n})();\n\nif (!BRAVE_API_KEY) {\n  console.error('ERROR: No Brave API key found. Set BRAVE_API_KEY or configure in clawdbot.json');\n  process.exit(1);\n}\n\nconst BRAVE_ENDPOINT = 'https://api.search.brave.com/res/v1/web/search';\nconst SEARCH_DELAY_MS = 1100;\nconst FETCH_DELAY_MS = 600;\nconst FETCH_TIMEOUT_MS = 10000;\nconst USER_AGENT = 'Mozilla/5.0 (compatible; ScoutBot/1.0; research)';\n\nconst QUERIES = [\n  '\"job order contracting\" \"contract awarded\" 2025 OR 2026',\n  '\"JOC contract\" \"awarded to\" contractor 2025 OR 2026',\n  'site:sam.gov \"job order contracting\" award',\n  '\"OMNIA Partners\" \"job order contracting\" awarded',\n  '\"Gordian\" \"JOC\" \"contract awarded\" 2025 OR 2026',\n  '\"Centennial Contractors\" JOC award',\n  '\"job order contracting\" RFP awarded state OR county OR city',\n  '\"indefinite delivery\" \"job order\" contracting award 2025 OR 2026',\n  '\"JOC\" \"task order\" contractor awarded government',\n  '\"cooperative contract\" \"job order contracting\" public agency',\n  'site:governmentbids.com \"job order contracting\"',\n  'site:bidnet.com \"job order contracting\"',\n  '\"JOC contract\" awarded million OR \"$\" contractor',\n  '\"construction task catalog\" contract awarded',\n  '\"unit price book\" \"job order\" awarded contractor',\n];\n\nconst US_STATES = [\n  'Alabama','Alaska','Arizona','Arkansas','California','Colorado','Connecticut',\n  'Delaware','Florida','Georgia','Hawaii','Idaho','Illinois','Indiana','Iowa',\n  'Kansas','Kentucky','Louisiana','Maine','Maryland','Massachusetts','Michigan',\n  'Minnesota','Mississippi','Missouri','Montana','Nebraska','Nevada','New Hampshire',\n  'New Jersey','New Mexico','New York','North Carolina','North Dakota','Ohio',\n  'Oklahoma','Oregon','Pennsylvania','Rhode Island','South Carolina','South Dakota',\n  'Tennessee','Texas','Utah','Vermont','Virginia','Washington','West Virginia',\n  'Wisconsin','Wyoming','District of Columbia',\n];\n\nconst JOC_PROVIDERS = ['Gordian', 'Centennial', 'ISES', 'JOC Solutions', 'The Gordian Group', 'OMNIA Partners'];\n\n// --- Utilities ---\nfunction sleep(ms) { return new Promise(r => setTimeout(r, ms)); }\n\nfunction fetchUrl(url, opts = {}) {\n  return new Promise((resolve, reject) => {\n    const timeout = opts.timeout || FETCH_TIMEOUT_MS;\n    const mod = url.startsWith('https') ? https : http;\n    const req = mod.get(url, {\n      headers: { 'User-Agent': USER_AGENT, 'Accept': 'text/html,application/json,*/*' },\n      timeout,\n    }, (res) => {\n      if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location) {\n        return fetchUrl(res.headers.location, opts).then(resolve).catch(reject);\n      }\n      if (res.statusCode !== 200) {\n        res.resume();\n        return reject(new Error(`HTTP ${res.statusCode}`));\n      }\n      const ct = res.headers['content-type'] || '';\n      if (ct.includes('pdf') || ct.includes('octet-stream')) {\n        res.resume();\n        return reject(new Error('Binary/PDF content'));\n      }\n      let data = '';\n      const maxBytes = 200000;\n      res.setEncoding('utf8');\n      res.on('data', chunk => {\n        data += chunk;\n        if (data.length > maxBytes) { res.destroy(); }\n      });\n      res.on('end', () => resolve(data));\n      res.on('error', reject);\n    });\n    req.on('timeout', () => { req.destroy(); reject(new Error('Timeout')); });\n    req.on('error', reject);\n  });\n}\n\nfunction braveSearch(query, count = 10) {\n  const url = `${BRAVE_ENDPOINT}?q=${encodeURIComponent(query)}&count=${count}`;\n  return new Promise((resolve, reject) => {\n    https.get(url, {\n      headers: {\n        'X-Subscription-Token': BRAVE_API_KEY,\n        'Accept': 'application/json',\n      },\n      timeout: 15000,\n    }, (res) => {\n      let data = '';\n      res.setEncoding('utf8');\n      res.on('data', c => data += c);\n      res.on('end', () => {\n        try { resolve(JSON.parse(data)); }\n        catch (e) { reject(new Error(`Parse error: ${data.slice(0, 200)}`)); }\n      });\n      res.on('error', reject);\n    }).on('error', reject);\n  });\n}\n\n// --- Extraction ---\nfunction extractDollars(text) {\n  const m = text.match(/\\$[\\d,]+(?:\\.\\d{2})?(?:\\s*(?:million|M|billion|B))?/gi);\n  return m ? m[0] : null;\n}\n\nfunction extractContractor(text) {\n  const patterns = [\n    /awarded\\s+to\\s+([A-Z][A-Za-z\\s&,.'()-]+?)(?:\\s*[,.]|\\s+for\\s|\\s+a\\s|\\s+the\\s|\\s+in\\s)/i,\n    /contractor[:\\s]+([A-Z][A-Za-z\\s&,.'()-]+?)(?:\\s*[,.]|\\s+for\\s|\\s+a\\s)/i,\n    /vendor[:\\s]+([A-Z][A-Za-z\\s&,.'()-]+?)(?:\\s*[,.]|\\s+for\\s|\\s+a\\s)/i,\n    /(?:awarded|selected|chosen)\\s+([A-Z][A-Za-z\\s&.'()-]+?(?:Inc|LLC|Corp|Co|Ltd|LP|Construction|Contractors|Services|Group|Enterprises|Company)\\.?)/i,\n    /([A-Z][A-Za-z\\s&.'()-]*?(?:Construction|Contractors|Contracting|Services|Builders|Group|Enterprises))\\s+(?:was|has been|were)\\s+(?:awarded|selected)/i,\n  ];\n  for (const p of patterns) {\n    const m = text.match(p);\n    if (m && m[1] && m[1].trim().length > 2 && m[1].trim().length < 80) {\n      return m[1].trim().replace(/[,.]$/, '');\n    }\n  }\n  return null;\n}\n\nfunction extractAgency(text) {\n  const patterns = [\n    /(?:by|for|from)\\s+(?:the\\s+)?([A-Z][A-Za-z\\s]+?(?:University|College|School District|County|City|State|Department|Agency|Authority|District|Board|Commission|Municipality))/i,\n    /([A-Z][A-Za-z\\s]+?(?:University|College|School District|County|City of \\w+|Department of \\w+))\\s+(?:has|awarded|announced|issued)/i,\n  ];\n  for (const p of patterns) {\n    const m = text.match(p);\n    if (m && m[1] && m[1].trim().length > 3 && m[1].trim().length < 80) {\n      return m[1].trim();\n    }\n  }\n  return null;\n}\n\nfunction extractLocation(text) {\n  for (const st of US_STATES) {\n    if (text.includes(st)) return st;\n  }\n  // Try abbreviations\n  const abbrMatch = text.match(/\\b([A-Z]{2})\\b/g);\n  const stateAbbrs = {\n    AL:'Alabama',AK:'Alaska',AZ:'Arizona',AR:'Arkansas',CA:'California',CO:'Colorado',\n    CT:'Connecticut',DE:'Delaware',FL:'Florida',GA:'Georgia',HI:'Hawaii',ID:'Idaho',\n    IL:'Illinois',IN:'Indiana',IA:'Iowa',KS:'Kansas',KY:'Kentucky',LA:'Louisiana',\n    ME:'Maine',MD:'Maryland',MA:'Massachusetts',MI:'Michigan',MN:'Minnesota',MS:'Mississippi',\n    MO:'Missouri',MT:'Montana',NE:'Nebraska',NV:'Nevada',NH:'New Hampshire',NJ:'New Jersey',\n    NM:'New Mexico',NY:'New York',NC:'North Carolina',ND:'North Dakota',OH:'Ohio',\n    OK:'Oklahoma',OR:'Oregon',PA:'Pennsylvania',RI:'Rhode Island',SC:'South Carolina',\n    SD:'South Dakota',TN:'Tennessee',TX:'Texas',UT:'Utah',VT:'Vermont',VA:'Virginia',\n    WA:'Washington',WV:'West Virginia',WI:'Wisconsin',WY:'Wyoming',DC:'District of Columbia',\n  };\n  if (abbrMatch) {\n    for (const a of abbrMatch) {\n      if (stateAbbrs[a]) return stateAbbrs[a];\n    }\n  }\n  return null;\n}\n\nfunction extractDate(text) {\n  // Try ISO-ish dates\n  let m = text.match(/(\\d{4}-\\d{2}-\\d{2})/);\n  if (m) return m[1];\n  // Try \"Month DD, YYYY\"\n  m = text.match(/(January|February|March|April|May|June|July|August|September|October|November|December)\\s+\\d{1,2},?\\s+\\d{4}/i);\n  if (m) {\n    try { return new Date(m[0]).toISOString().slice(0, 10); } catch {}\n  }\n  // Try MM/DD/YYYY\n  m = text.match(/(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})/);\n  if (m) return `${m[3]}-${m[1].padStart(2,'0')}-${m[2].padStart(2,'0')}`;\n  return null;\n}\n\nfunction extractJocProvider(text) {\n  for (const p of JOC_PROVIDERS) {\n    if (text.toLowerCase().includes(p.toLowerCase())) return p;\n  }\n  return null;\n}\n\nfunction stripHtml(html) {\n  return html\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n    .replace(/<[^>]+>/g, ' ')\n    .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')\n    .replace(/&nbsp;/g, ' ').replace(/&#\\d+;/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\n// --- Main ---\nasync function run() {\n  const today = new Date().toISOString().slice(0, 10);\n  const reportsDir = path.join(__dirname, '..', 'agents', 'scout', 'reports');\n  fs.mkdirSync(reportsDir, { recursive: true });\n\n  const allResults = new Map(); // url -> search result\n  let errors = [];\n\n  // Phase 1: Brave searches\n  console.log(`\\n🔍 Running ${QUERIES.length} Brave searches...\\n`);\n  for (let i = 0; i < QUERIES.length; i++) {\n    const q = QUERIES[i];\n    console.log(`  [${i + 1}/${QUERIES.length}] ${q.slice(0, 60)}...`);\n    try {\n      const res = await braveSearch(q);\n      const results = res?.web?.results || [];\n      console.log(`    → ${results.length} results`);\n      for (const r of results) {\n        if (!allResults.has(r.url)) {\n          allResults.set(r.url, {\n            title: r.title || '',\n            snippet: r.description || '',\n            url: r.url,\n            query: q,\n          });\n        }\n      }\n    } catch (e) {\n      console.log(`    ⚠ Search error: ${e.message}`);\n      errors.push({ phase: 'search', query: q, error: e.message });\n    }\n    if (i < QUERIES.length - 1) await sleep(SEARCH_DELAY_MS);\n  }\n\n  console.log(`\\n📄 ${allResults.size} unique URLs found. Fetching pages...\\n`);\n\n  // Phase 2: Fetch and extract\n  const leads = [];\n  const urls = [...allResults.entries()];\n  let fetched = 0, skipped = 0;\n\n  for (let i = 0; i < urls.length; i++) {\n    const [url, meta] = urls[i];\n    // Combine snippet + title for initial extraction\n    const snippetText = `${meta.title} ${meta.snippet}`;\n\n    let pageText = '';\n    try {\n      const html = await fetchUrl(url);\n      pageText = stripHtml(html).slice(0, 50000);\n      fetched++;\n    } catch (e) {\n      skipped++;\n      // Still use snippet data\n    }\n\n    const fullText = `${snippetText} ${pageText}`;\n\n    const lead = {\n      agency: extractAgency(fullText) || extractAgency(snippetText) || 'Unknown',\n      contractor: extractContractor(fullText) || extractContractor(snippetText) || 'Unknown',\n      jocProvider: extractJocProvider(fullText) || 'Unknown',\n      value: extractDollars(fullText) || 'Unknown',\n      location: extractLocation(fullText) || 'Unknown',\n      date: extractDate(fullText) || 'Unknown',\n      source: url,\n      title: meta.title,\n      snippet: meta.snippet.slice(0, 300),\n    };\n\n    leads.push(lead);\n\n    if (i < urls.length - 1) await sleep(FETCH_DELAY_MS);\n    if ((i + 1) % 20 === 0) console.log(`  Processed ${i + 1}/${urls.length}...`);\n  }\n\n  console.log(`\\n✅ Fetched: ${fetched}, Skipped: ${skipped}, Total leads: ${leads.length}\\n`);\n\n  // --- Stats ---\n  const contractors = new Set(leads.map(l => l.contractor).filter(c => c !== 'Unknown'));\n  const agencies = new Set(leads.map(l => l.agency).filter(a => a !== 'Unknown'));\n  const knownValues = leads.map(l => l.value).filter(v => v !== 'Unknown');\n\n  let totalValue = 0;\n  for (const v of knownValues) {\n    let num = parseFloat(v.replace(/[$,]/g, ''));\n    if (/million|M/i.test(v)) num *= 1_000_000;\n    if (/billion|B/i.test(v)) num *= 1_000_000_000;\n    if (!isNaN(num)) totalValue += num;\n  }\n\n  const summary = {\n    contractsFound: leads.length,\n    uniqueContractors: contractors.size,\n    uniqueAgencies: agencies.size,\n    totalValue: totalValue > 0 ? `$${totalValue.toLocaleString()}` : 'Unknown',\n  };\n\n  // --- Output JSON ---\n  const jsonPath = path.join(reportsDir, `joc-leads-${today}.json`);\n  fs.writeFileSync(jsonPath, JSON.stringify(leads, null, 2));\n  console.log(`📁 JSON: ${jsonPath}`);\n\n  // --- Output CSV ---\n  const csvPath = path.join(reportsDir, `joc-leads-${today}.csv`);\n  const csvHeader = 'agency,contractor,joc_provider,value,location,date,source_url';\n  const csvRows = leads.map(l =>\n    [l.agency, l.contractor, l.jocProvider, l.value, l.location, l.date, l.source]\n      .map(f => `\"${String(f).replace(/\"/g, '\"\"')}\"`)\n      .join(',')\n  );\n  fs.writeFileSync(csvPath, [csvHeader, ...csvRows].join('\\n'));\n  console.log(`📁 CSV: ${csvPath}`);\n\n  // --- Output Markdown ---\n  const mdPath = path.join(reportsDir, `joc-leads-${today}.md`);\n  let md = `# JOC Contract Leads — ${today}\\n\\n`;\n  md += `## Summary\\n`;\n  md += `- ${summary.contractsFound} contracts found\\n`;\n  md += `- ${summary.uniqueContractors} unique contractors identified\\n`;\n  md += `- ${summary.uniqueAgencies} unique agencies\\n`;\n  md += `- Total contract value: ${summary.totalValue}\\n\\n`;\n  md += `## Leads\\n\\n`;\n\n  leads.forEach((l, i) => {\n    md += `### ${i + 1}. ${l.agency} → ${l.contractor}\\n`;\n    md += `- **Value:** ${l.value}\\n`;\n    md += `- **Location:** ${l.location}\\n`;\n    md += `- **JOC Provider:** ${l.jocProvider}\\n`;\n    md += `- **Date:** ${l.date}\\n`;\n    md += `- **Source:** [${l.title.slice(0, 60)}](${l.source})\\n`;\n    md += `- **Notes:** ${l.snippet.slice(0, 150)}\\n\\n`;\n  });\n\n  fs.writeFileSync(mdPath, md);\n  console.log(`📁 Markdown: ${mdPath}`);\n\n  // --- Print summary ---\n  console.log(`\\n${'='.repeat(60)}`);\n  console.log(`JOC LEAD SCRAPER — ${today}`);\n  console.log(`${'='.repeat(60)}`);\n  console.log(`Contracts found:      ${summary.contractsFound}`);\n  console.log(`Unique contractors:   ${summary.uniqueContractors}`);\n  console.log(`Unique agencies:      ${summary.uniqueAgencies}`);\n  console.log(`Total contract value: ${summary.totalValue}`);\n  console.log(`${'='.repeat(60)}\\n`);\n\n  console.log('Top 5 leads:');\n  leads.slice(0, 5).forEach((l, i) => {\n    console.log(`  ${i + 1}. ${l.agency} → ${l.contractor} | ${l.value} | ${l.location}`);\n  });\n\n  return { leads, summary };\n}\n\n// Allow import or direct execution\nif (require.main === module) {\n  run().catch(e => { console.error('Fatal:', e); process.exit(1); });\n}\n\nmodule.exports = { run };\n"}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-opus-4-5","usage":{"input":1,"output":5118,"cacheRead":13644,"cacheWrite":206,"totalTokens":18969,"cost":{"input":0.000005,"output":0.12795,"cacheRead":0.006822,"cacheWrite":0.0012875,"total":0.1360645}},"stopReason":"toolUse","timestamp":1769987477608}}
