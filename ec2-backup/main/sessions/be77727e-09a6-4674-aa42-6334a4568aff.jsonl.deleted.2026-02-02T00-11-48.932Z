one = (val, isErr) => {\n      if (resolved) return;\n      resolved = true;\n      clearTimeout(hardTimer);\n      if (isErr) reject(val); else resolve(val);\n    };\n    const hardTimer = setTimeout(() => {\n      done(new Error('hard timeout'), true);\n      try { req.destroy(); } catch {}\n    }, FETCH_TIMEOUT_MS);\n\n    const mod = url.startsWith('https') ? https : http;\n    const req = mod.get(url, {\n      headers: { 'User-Agent': USER_AGENT, 'Accept': 'text/html,application/json,*/*' },\n      timeout: 5000,\n    }, (res) => {\n      if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location) {\n        res.resume();\n        clearTimeout(hardTimer);\n        resolved = true;\n        return fetchUrl(res.headers.location, opts, redirects + 1).then(resolve).catch(reject);\n      }\n      if (res.statusCode !== 200) {\n        res.resume();\n        return done(new Error(`HTTP ${res.statusCode}`), true);\n      }\n      const ct = res.headers['content-type'] || '';\n      if (ct.includes('pdf') || ct.includes('octet-stream')) {\n        res.resume();\n        return done(new Error('Binary/PDF'), true);\n      }\n      let data = '';\n      res.setEncoding('utf8');\n      res.on('data', chunk => {\n        data += chunk;\n        if (data.length > 200000) { res.destroy(); done(data, false); }\n      });\n      res.on('end', () => done(data, false));\n      res.on('error', () => done(data || '', false));\n    });\n    req.on('timeout', () => { req.destroy(); });\n    req.on('error', (e) => done(e, true));\n  });\n}"}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-opus-4-5","usage":{"input":1,"output":1106,"cacheRead":38347,"cacheWrite":150,"totalTokens":39604,"cost":{"input":0.000005,"output":0.02765,"cacheRead":0.0191735,"cacheWrite":0.0009375000000000001,"total":0.047766}},"stopReason":"toolUse","timestamp":1769987973233}}
