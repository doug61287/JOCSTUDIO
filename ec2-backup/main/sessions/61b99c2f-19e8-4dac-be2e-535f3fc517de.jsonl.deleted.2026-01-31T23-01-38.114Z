{"type":"message","id":"03700c56","parentId":"fbf07c83","timestamp":"2026-01-31T22:03:01.906Z","message":{"role":"assistant","content":[{"type":"text","text":"Now I understand the API structure. Gamma API for market discovery, CLOB for order books. Let me build the system:"},{"type":"toolCall","id":"toolu_01NxqbFVse9cjQT17QhGjBdL","name":"write","arguments":{"path":"/home/ec2-user/clawd/projects/polymarket-copytrade/src/arbitrage-scanner.js","content":"const fetch = require('node-fetch');\nconst fs = require('fs');\nconst path = require('path');\n\nconst GAMMA_API = 'https://gamma-api.polymarket.com';\nconst CLOB_API = 'https://clob.polymarket.com';\nconst DATA_DIR = path.join(__dirname, '..', 'data');\nconst OPP_FILE = path.join(DATA_DIR, 'arbitrage-opportunities.jsonl');\nconst ALERTS_FILE = path.join(DATA_DIR, 'alerts-pending.jsonl');\nconst SCAN_INTERVAL = 10_000; // 10 seconds\nconst ARB_THRESHOLD = 0.95; // spread < 0.95 means 5%+ profit after fees\nconst ALERT_PROFIT_MIN = 5; // $5 minimum for telegram alert\nconst PAPER_TRADE_PROFIT_MIN = 0.50;\n\n// Ensure data dir exists\nif (!fs.existsSync(DATA_DIR)) fs.mkdirSync(DATA_DIR, { recursive: true });\n\nfunction appendJsonl(file, obj) {\n  fs.appendFileSync(file, JSON.stringify(obj) + '\\n');\n}\n\nfunction log(...args) {\n  console.log(`[${new Date().toISOString()}]`, ...args);\n}\n\nasync function fetchActiveMarkets() {\n  const markets = [];\n  let offset = 0;\n  const limit = 100;\n  // Fetch active open markets from gamma API\n  while (true) {\n    const url = `${GAMMA_API}/markets?limit=${limit}&offset=${offset}&active=true&closed=false`;\n    const resp = await fetch(url);\n    if (!resp.ok) { log('Gamma API error:', resp.status); break; }\n    const data = await resp.json();\n    if (!data.length) break;\n    for (const m of data) {\n      if (m.clobTokenIds && m.active && !m.closed) {\n        markets.push(m);\n      }\n    }\n    offset += limit;\n    if (data.length < limit) break;\n    // Safety: don't fetch more than 2000 markets per cycle\n    if (offset >= 2000) break;\n  }\n  return markets;\n}\n\nasync function fetchOrderBook(tokenId) {\n  try {\n    const resp = await fetch(`${CLOB_API}/book?token_id=${tokenId}`);\n    if (!resp.ok) return null;\n    return await resp.json();\n  } catch (e) {\n    return null;\n  }\n}\n\nfunction getBestAsk(book) {\n  if (!book || !book.asks || !book.asks.length) return null;\n  // asks are sorted by price ascending (best ask = lowest)\n  let best = null;\n  for (const a of book.asks) {\n    const price = parseFloat(a.price);\n    const size = parseFloat(a.size);\n    if (!best || price < best.price) {\n      best = { price, size };\n    }\n  }\n  return best;\n}\n\nfunction getBestBid(book) {\n  if (!book || !book.bids || !book.bids.length) return null;\n  let best = null;\n  for (const b of book.bids) {\n    const price = parseFloat(b.price);\n    const size = parseFloat(b.size);\n    if (!best || price > best.price) {\n      best = { price, size };\n    }\n  }\n  return best;\n}\n\nasync function checkBinaryMarket(market) {\n  const tokenIds = JSON.parse(market.clobTokenIds);\n  if (tokenIds.length !== 2) return null;\n\n  const [book1, book2] = await Promise.all([\n    fetchOrderBook(tokenIds[0]),\n    fetchOrderBook(tokenIds[1])\n  ]);\n\n  const ask1 = getBestAsk(book1);\n  const ask2 = getBestAsk(book2);\n  const bid1 = getBestBid(book1);\n  const bid2 = getBestBid(book2);\n\n  const opportunities = [];\n\n  // Buy-both-sides arb: best_ask_yes + best_ask_no < 1.00\n  if (ask1 && ask2) {\n    const spread = ask1.price + ask2.price;\n    if (spread < ARB_THRESHOLD) {\n      const liquidity = Math.min(ask1.size, ask2.size);\n      const profitPerUnit = 1.0 - spread;\n      const totalProfit = profitPerUnit * liquidity;\n      opportunities.push({\n        type: 'buy_both',\n        timestamp: new Date().toISOString(),\n        market_slug: market.slug,\n        market_question: market.question,\n        yes_ask: ask1.price,\n        no_ask: ask2.price,\n        spread: Math.round(spread * 10000) / 10000,\n        profit_per_unit: Math.round(profitPerUnit * 10000) / 10000,\n        liquidity: Math.round(liquidity * 100) / 100,\n        potential_profit: Math.round(totalProfit * 100) / 100,\n      });\n    }\n  }\n\n  // Sell-both-sides arb: best_bid_yes + best_bid_no > 1.00\n  if (bid1 && bid2) {\n    const bidSum = bid1.price + bid2.price;\n    if (bidSum > 1.05) { // need to exceed 1.00 + fees\n      const liquidity = Math.min(bid1.size, bid2.size);\n      const profitPerUnit = bidSum - 1.0;\n      const totalProfit = profitPerUnit * liquidity;\n      opportunities.push({\n        type: 'sell_both',\n        timestamp: new Date().toISOString(),\n        market_slug: market.slug,\n        market_question: market.question,\n        yes_bid: bid1.price,\n        no_bid: bid2.price,\n        bid_sum: Math.round(bidSum * 10000) / 10000,\n        profit_per_unit: Math.round(profitPerUnit * 10000) / 10000,\n        liquidity: Math.round(liquidity * 100) / 100,\n        potential_profit: Math.round(totalProfit * 100) / 100,\n      });\n    }\n  }\n\n  return opportunities;\n}\n\nasync function checkMultiOutcomeMarket(market) {\n  const tokenIds = JSON.parse(market.clobTokenIds);\n  if (tokenIds.length <= 2) return null;\n\n  const books = await Promise.all(tokenIds.map(id => fetchOrderBook(id)));\n  const asks = books.map(b => getBestAsk(b));\n\n  // If any outcome has no ask, skip\n  if (asks.some(a => a === null)) return null;\n\n  const totalAsk = asks.reduce((sum, a) => sum + a.price, 0);\n  if (totalAsk < ARB_THRESHOLD) {\n    const liquidity = Math.min(...asks.map(a => a.size));\n    const profitPerUnit = 1.0 - totalAsk;\n    const totalProfit = profitPerUnit * liquidity;\n    return [{\n      type: 'multi_buy_all',\n      timestamp: new Date().toISOString(),\n      market_slug: market.slug,\n      market_question: market.question,\n      num_outcomes: tokenIds.length,\n      ask_prices: asks.map(a => a.price),\n      total_ask: Math.round(totalAsk * 10000) / 10000,\n      profit_per_unit: Math.round(profitPerUnit * 10000) / 10000,\n      liquidity: Math.round(liquidity * 100) / 100,\n      potential_profit: Math.round(totalProfit * 100) / 100,\n    }];\n  }\n  return null;\n}\n\nlet scanCount = 0;\nlet totalOppsFound = 0;\n\nasync function scan() {\n  scanCount++;\n  log(`Scan #${scanCount} starting...`);\n\n  try {\n    const markets = await fetchActiveMarkets();\n    log(`Fetched ${markets.length} active markets`);\n\n    let oppsThisScan = 0;\n\n    for (const market of markets) {\n      try {\n        const tokenIds = JSON.parse(market.clobTokenIds || '[]');\n        let opps;\n        if (tokenIds.length === 2) {\n          opps = await checkBinaryMarket(market);\n        } else if (tokenIds.length > 2) {\n          opps = await checkMultiOutcomeMarket(market);\n        }\n\n        if (opps && opps.length > 0) {\n          for (const opp of opps) {\n            oppsThisScan++;\n            totalOppsFound++;\n            appendJsonl(OPP_FILE, opp);\n\n            log(`🎯 ARB: ${opp.type} | ${opp.market_question?.slice(0, 60)} | spread=${opp.spread || opp.total_ask} | profit=$${opp.potential_profit}`);\n\n            // Alert if profit > $5\n            if (opp.potential_profit >= ALERT_PROFIT_MIN) {\n              appendJsonl(ALERTS_FILE, opp);\n              log(`🚨 ALERT written for $${opp.potential_profit} opportunity`);\n            }\n          }\n        }\n      } catch (e) {\n        // Skip individual market errors\n      }\n\n      // Small delay to avoid hammering the API\n      await new Promise(r => setTimeout(r, 50));\n    }\n\n    log(`Scan #${scanCount} complete: ${oppsThisScan} opportunities (${totalOppsFound} total)`);\n  } catch (err) {\n    log('Scan error:', err.message);\n  }\n}\n\nasync function main() {\n  log('Polymarket Arbitrage Scanner starting...');\n  log(`Threshold: spread < ${ARB_THRESHOLD} | Alert min: $${ALERT_PROFIT_MIN}`);\n\n  // Run immediately, then on interval\n  await scan();\n  setInterval(scan, SCAN_INTERVAL);\n}\n\nmain().catch(err => {\n  console.error('Fatal error:', err);\n  process.exit(1);\n});\n"}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-opus-4-5","usage":{"input":1,"output":2713,"cacheRead":15941,"cacheWrite":1251,"totalTokens":19906,"cost":{"input":0.000005,"output":0.067825,"cacheRead":0.0079705,"cacheWrite":0.007818750000000001,"total":0.08361925}},"stopReason":"toolUse","timestamp":1769896946614}}
