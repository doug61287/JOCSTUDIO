{"type":"message","id":"8d6e60af","parentId":"2f698cef","timestamp":"2026-01-31T22:03:23.953Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"toolu_01PxF3Cx2RatFeg71AEjr1B8","name":"write","arguments":{"path":"/home/ec2-user/clawd/projects/polymarket-copytrade/src/arbitrage-paper-trader.js","content":"const fs = require('fs');\nconst path = require('path');\n\nconst DATA_DIR = path.join(__dirname, '..', 'data');\nconst OPP_FILE = path.join(DATA_DIR, 'arbitrage-opportunities.jsonl');\nconst TRADES_FILE = path.join(DATA_DIR, 'arbitrage-paper-trades.jsonl');\nconst STATE_FILE = path.join(DATA_DIR, 'arbitrage-paper-state.json');\nconst CHECK_INTERVAL = 5_000; // check every 5 seconds\nconst MIN_PROFIT = 0.50; // minimum $0.50 profit to paper trade\nconst SIMULATED_CAPITAL = 1000; // $1000 simulated capital\n\nfunction log(...args) {\n  console.log(`[${new Date().toISOString()}]`, ...args);\n}\n\nfunction loadState() {\n  try {\n    return JSON.parse(fs.readFileSync(STATE_FILE, 'utf8'));\n  } catch {\n    return {\n      totalCapital: SIMULATED_CAPITAL,\n      deployed: 0,\n      realizedPnl: 0,\n      trades: 0,\n      opportunitiesSeen: 0,\n      lastProcessedLine: 0,\n      dailyStats: {},\n      positions: [] // each: { market_slug, entrySpread, size, entryTime, cost }\n    };\n  }\n}\n\nfunction saveState(state) {\n  fs.writeFileSync(STATE_FILE, JSON.stringify(state, null, 2));\n}\n\nfunction appendTrade(trade) {\n  fs.appendFileSync(TRADES_FILE, JSON.stringify(trade) + '\\n');\n}\n\nfunction getToday() {\n  return new Date().toISOString().split('T')[0];\n}\n\nfunction ensureDailyStats(state) {\n  const today = getToday();\n  if (!state.dailyStats[today]) {\n    state.dailyStats[today] = {\n      opportunities: 0,\n      tradesTaken: 0,\n      simulatedPnl: 0,\n    };\n  }\n  return state.dailyStats[today];\n}\n\nfunction processOpportunity(state, opp) {\n  state.opportunitiesSeen++;\n  const daily = ensureDailyStats(state);\n  daily.opportunities++;\n\n  if (opp.potential_profit < MIN_PROFIT) return;\n  if (opp.type !== 'buy_both' && opp.type !== 'multi_buy_all') return;\n\n  // Calculate position size: buy min of available liquidity and 10% of remaining capital\n  const available = state.totalCapital - state.deployed;\n  if (available < 10) return; // need at least $10\n\n  const spread = opp.spread || opp.total_ask;\n  const maxUnits = Math.min(opp.liquidity, available / spread);\n  const cost = maxUnits * spread;\n\n  // Simulate: buy both sides, guaranteed payout of $1 per unit\n  const payout = maxUnits * 1.0;\n  const fees = cost * 0.02; // ~2% fee estimate\n  const profit = payout - cost - fees;\n\n  if (profit <= 0) return;\n\n  const trade = {\n    timestamp: new Date().toISOString(),\n    type: 'paper_arb',\n    market_slug: opp.market_slug,\n    market_question: opp.market_question,\n    spread,\n    units: Math.round(maxUnits * 100) / 100,\n    cost: Math.round(cost * 100) / 100,\n    expected_payout: Math.round(payout * 100) / 100,\n    fees: Math.round(fees * 100) / 100,\n    expected_profit: Math.round(profit * 100) / 100,\n  };\n\n  state.trades++;\n  state.deployed += cost;\n  state.realizedPnl += profit; // instant settlement for paper trading\n  state.deployed -= cost; // release capital immediately (simulating instant resolution)\n\n  daily.tradesTaken++;\n  daily.simulatedPnl += profit;\n\n  appendTrade(trade);\n  log(`📝 PAPER TRADE: ${opp.market_question?.slice(0, 50)} | cost=$${trade.cost} | profit=$${trade.expected_profit}`);\n}\n\nfunction printDailySummary(state) {\n  const today = getToday();\n  const daily = state.dailyStats[today];\n  if (!daily) return;\n  log(`📊 Daily Summary (${today}): ${daily.opportunities} opportunities | ${daily.tradesTaken} trades | P&L: $${Math.round(daily.simulatedPnl * 100) / 100}`);\n  log(`📊 All-time: ${state.opportunitiesSeen} opps | ${state.trades} trades | P&L: $${Math.round(state.realizedPnl * 100) / 100}`);\n}\n\nasync function main() {\n  log('Arbitrage Paper Trader starting...');\n  const state = loadState();\n  let lastSummary = Date.now();\n\n  setInterval(() => {\n    try {\n      if (!fs.existsSync(OPP_FILE)) return;\n      const lines = fs.readFileSync(OPP_FILE, 'utf8').trim().split('\\n');\n      const newLines = lines.slice(state.lastProcessedLine);\n\n      for (const line of newLines) {\n        if (!line.trim()) continue;\n        try {\n          const opp = JSON.parse(line);\n          processOpportunity(state, opp);\n        } catch {}\n        state.lastProcessedLine++;\n      }\n\n      saveState(state);\n\n      // Print daily summary every 5 minutes\n      if (Date.now() - lastSummary > 300_000) {\n        printDailySummary(state);\n        lastSummary = Date.now();\n      }\n    } catch (err) {\n      log('Error:', err.message);\n    }\n  }, CHECK_INTERVAL);\n}\n\nmain().catch(err => {\n  console.error('Fatal:', err);\n  process.exit(1);\n});\n"}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-opus-4-5","usage":{"input":1,"output":1637,"cacheRead":17192,"cacheWrite":2761,"totalTokens":21591,"cost":{"input":0.000005,"output":0.040925,"cacheRead":0.008596,"cacheWrite":0.01725625,"total":0.06678225}},"stopReason":"toolUse","timestamp":1769896981922}}
