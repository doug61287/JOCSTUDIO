{"type":"message","id":"8a829340","parentId":"71ba2a3c","timestamp":"2026-02-01T04:06:25.466Z","message":{"role":"assistant","content":[{"type":"toolCall","id":"toolu_01UzT2fFBtYVczP2UWAwtSmv","name":"write","arguments":{"path":"/home/ec2-user/clawd/scripts/daily-standup.sh","content":"#!/bin/bash\n# Daily Standup Briefing Generator\n# Collects status from all projects and formats a morning briefing\n# Output: stdout (consumed by cron → Bai Bureh → Telegram)\n\nset -euo pipefail\n\nCLAWD_DIR=\"/home/ec2-user/clawd\"\nDATE=$(date -u +\"%Y-%m-%d\")\nTIME=$(date -u +\"%H:%M UTC\")\n\necho \"☀️ MORNING STANDUP — $DATE ($TIME)\"\necho \"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\"\necho \"\"\n\n# 1. PM2 Process Status\necho \"## 🖥️ SYSTEM\"\nif command -v pm2 &>/dev/null; then\n    PM2_STATUS=$(pm2 jlist 2>/dev/null || echo \"[]\")\n    TOTAL=$(echo \"$PM2_STATUS\" | jq 'length' 2>/dev/null || echo \"?\")\n    ONLINE=$(echo \"$PM2_STATUS\" | jq '[.[] | select(.pm2_env.status == \"online\")] | length' 2>/dev/null || echo \"?\")\n    ERRORED=$(echo \"$PM2_STATUS\" | jq '[.[] | select(.pm2_env.status == \"errored\")] | length' 2>/dev/null || echo \"0\")\n    echo \"PM2: $ONLINE/$TOTAL online\"\n    if [ \"$ERRORED\" != \"0\" ]; then\n        echo \"⚠️ $ERRORED errored processes:\"\n        echo \"$PM2_STATUS\" | jq -r '.[] | select(.pm2_env.status == \"errored\") | \"  - \\(.name)\"' 2>/dev/null\n    fi\n    # List all processes\n    echo \"$PM2_STATUS\" | jq -r '.[] | \"  • \\(.name): \\(.pm2_env.status) (restarts: \\(.pm2_env.restart_time))\"' 2>/dev/null || true\nelse\n    echo \"PM2: not installed\"\nfi\necho \"\"\n\n# 2. Biomed BorBor\necho \"## 🏥 BIOMED BORBOR\"\nif pm2 jlist 2>/dev/null | jq -e '.[] | select(.name | test(\"biomed|borbor\"; \"i\"))' &>/dev/null; then\n    BOT_STATUS=$(pm2 jlist 2>/dev/null | jq -r '.[] | select(.name | test(\"biomed|borbor\"; \"i\")) | \"\\(.name): \\(.pm2_env.status)\"')\n    echo \"$BOT_STATUS\"\nelse\n    echo \"No biomed PM2 processes found\"\nfi\n# Recent webhook logs (last 24h)\nWEBHOOK_LOG=\"$CLAWD_DIR/projects/biomed-bot/logs/webhook.log\"\nif [ -f \"$WEBHOOK_LOG\" ]; then\n    RECENT=$(find \"$WEBHOOK_LOG\" -mmin -1440 2>/dev/null | wc -l)\n    if [ \"$RECENT\" -gt 0 ]; then\n        LINES=$(wc -l < \"$WEBHOOK_LOG\")\n        echo \"Webhook log: $LINES lines (active)\"\n    fi\nelse\n    echo \"No webhook log found\"\nfi\necho \"\"\n\n# 3. Polymarket\necho \"## 📊 POLYMARKET\"\nPAPER_STATE=\"$CLAWD_DIR/projects/polymarket-copytrade/data/paper-state.json\"\nif [ -f \"$PAPER_STATE\" ]; then\n    LAST_SCAN=$(jq -r '.lastScan // \"unknown\"' \"$PAPER_STATE\" 2>/dev/null)\n    SEEN_TRADES=$(jq '.seenTrades | length' \"$PAPER_STATE\" 2>/dev/null || echo \"?\")\n    echo \"Last scan: $LAST_SCAN\"\n    echo \"Seen trades: $SEEN_TRADES\"\nelse\n    echo \"No paper-state.json found\"\nfi\nPORTFOLIO=\"$CLAWD_DIR/projects/polymarket-copytrade/data/paper-portfolio.json\"\nif [ -f \"$PORTFOLIO\" ]; then\n    POS_COUNT=$(jq 'if type == \"array\" then length elif type == \"object\" then (keys | length) else 0 end' \"$PORTFOLIO\" 2>/dev/null || echo \"?\")\n    echo \"Portfolio positions: $POS_COUNT\"\nfi\necho \"\"\n\n# 4. Blueprint / HHC Takeoff\necho \"## 🏗️ BLUEPRINT — HHC BROOKLYN DENTAL\"\nPROGRESS=\"$CLAWD_DIR/projects/blueprint/hhc-brooklyn-dental/takeoff_progress.json\"\nif [ -f \"$PROGRESS\" ]; then\n    COMPLETE=$(jq '.summary.complete // 0' \"$PROGRESS\" 2>/dev/null)\n    TOTAL_ITEMS=$(jq '.metadata.total_items // 298' \"$PROGRESS\" 2>/dev/null)\n    ESCALATED=$(jq '.summary.escalated // 0' \"$PROGRESS\" 2>/dev/null)\n    echo \"Progress: $COMPLETE/$TOTAL_ITEMS items complete\"\n    echo \"Escalated: $ESCALATED items need Doug's input\"\nelse\n    echo \"No takeoff_progress.json yet — architecture defined, awaiting first batch\"\nfi\nWORKING=\"$CLAWD_DIR/agents/takeoff/memory/WORKING.md\"\nif [ -f \"$WORKING\" ]; then\n    # Extract current status line\n    grep -m1 \"^## Current Status:\" \"$WORKING\" 2>/dev/null || true\nfi\necho \"\"\n\n# 5. Other Projects\necho \"## 📋 OTHER\"\n# Lebbie's Chocolates\nif pm2 jlist 2>/dev/null | jq -e '.[] | select(.name | test(\"lebbie|chocolate\"; \"i\"))' &>/dev/null; then\n    echo \"Lebbie's Chocolates: $(pm2 jlist 2>/dev/null | jq -r '.[] | select(.name | test(\"lebbie|chocolate\"; \"i\")) | .pm2_env.status')\"\nfi\n# Dashboard\nif pm2 jlist 2>/dev/null | jq -e '.[] | select(.name | test(\"dashboard|bureh\"; \"i\"))' &>/dev/null; then\n    echo \"Dashboard: $(pm2 jlist 2>/dev/null | jq -r '.[] | select(.name | test(\"dashboard|bureh\"; \"i\")) | .pm2_env.status')\"\nfi\necho \"\"\n\necho \"━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\"\necho \"End standup. Have a good day, Doug. 🫡\"\n"}}],"api":"anthropic-messages","provider":"anthropic","model":"claude-opus-4-5","usage":{"input":1,"output":1780,"cacheRead":27710,"cacheWrite":409,"totalTokens":29900,"cost":{"input":0.000005,"output":0.044500000000000005,"cacheRead":0.013855,"cacheWrite":0.00255625,"total":0.060916250000000005}},"stopReason":"toolUse","timestamp":1769918761487}}
